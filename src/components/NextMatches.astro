---
import type { Partido } from '../lib/liga';
import MatchRow from './MatchRow.astro';

export interface Props {
	partidos: Partido[];
}

const { partidos } = Astro.props;

const jornadaNumero = partidos[0]?.jornada.numero;

const fechaLarga = new Intl.DateTimeFormat('es-CL', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
});

const fechaCorta = new Intl.DateTimeFormat('es-CL', {
	weekday: 'short',
	day: 'numeric',
	month: 'short',
});

function dia(fecha: string): Date {
	return new Date(`${fecha}T12:00:00`);
}

const capitalizar = (texto: string): string => texto.charAt(0).toUpperCase() + texto.slice(1);

const fechas = partidos.map((partido) => partido.fecha).sort();
const rangoFechas = fechas.length
	? capitalizar(
			fechas[0] === fechas[fechas.length - 1]
				? fechaLarga.format(dia(fechas[0]))
				: `${fechaCorta.format(dia(fechas[0]))} al ${fechaLarga.format(dia(fechas[fechas.length - 1]))}`,
		)
	: '';
---

<section class="tablero" aria-labelledby="tablero-titulo">
	<div class="container">
		<div class="tablero__cabecera">
			<h1 class="tablero__titulo" id="tablero-titulo">
				Fecha <span class="tablero__numero">{jornadaNumero ?? '—'}</span>
			</h1>
			{rangoFechas && (
				<p class="tablero__detalle">
					<span>{rangoFechas}</span>
				</p>
			)}
		</div>

		{
			partidos.length > 0 ? (
				<ol class="tablero__lista">
					{partidos.map((partido) => (
						<li>
							<MatchRow partido={partido} href={`/partidos/${partido.slug}`} />
						</li>
					))}
				</ol>
			) : (
				<p class="tablero__vacio">
					Todavía no hay partidos programados. Las fechas se publican acá cuando se confirman.
				</p>
			)
		}

		<a class="tablero__enlace" href="/fixture">Ver todas las jornadas</a>
	</div>
</section>

<style>
	.tablero {
		padding: var(--spacing-xl) 0 var(--spacing-2xl);
	}

	.tablero__cabecera {
		margin-bottom: var(--spacing-xl);
	}

	@media (prefers-reduced-motion: no-preference) {
		.tablero__cabecera {
			animation: tableroEntra 0.5s ease-out both;
		}
	}

	.tablero__titulo {
		font-family: var(--font-headline);
		font-size: clamp(3.25rem, 15vw, 7.5rem);
		font-weight: 400;
		line-height: 0.9;
		letter-spacing: -0.01em;
		text-transform: uppercase;
		color: var(--color-neutral);
	}

	.tablero__numero {
		color: var(--color-primary);
	}

	.tablero__detalle {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-md);
		margin-top: var(--spacing-md);
		font-family: var(--font-body);
		font-size: 0.95rem;
		color: var(--color-secondary);
	}

	.tablero__lista {
		display: flex;
		flex-direction: column;
	}

	.tablero__lista li + li :global(.fila) {
		border-top: 1px solid rgba(255, 255, 255, 0.11);
	}

	.tablero__vacio {
		padding: var(--spacing-xl) 0;
		font-size: 0.95rem;
		color: var(--color-secondary);
	}

	.tablero__enlace {
		display: inline-block;
		margin-top: var(--spacing-lg);
		padding-bottom: 2px;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-neutral);
		border-bottom: 1px solid var(--color-primary);
	}

	@media (min-width: 768px) {
		.tablero {
			padding: var(--spacing-2xl) 0;
		}

		.tablero__detalle {
			font-size: 1.05rem;
		}
	}
</style>
