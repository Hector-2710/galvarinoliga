---
import ClubLogo from './ClubLogo.astro';

export interface Team {
	pos: number;
	equipo_nombre: string;
	logo?: string;
	pj: number;
	g: number;
	e: number;
	p: number;
	gf: number;
	gc: number;
	dg: number;
	pts: number;
}

export interface Props {
	teams: Team[];
	ocultarTitulo?: boolean;
}

const { teams, ocultarTitulo = false } = Astro.props;
---

<section class="tabla" aria-labelledby={ocultarTitulo ? undefined : 'tabla-titulo'}>
	<div class="container">
		{!ocultarTitulo && <h2 class="tabla__titulo" id="tabla-titulo">Tabla de posiciones</h2>}

		{
			teams.length > 0 ? (
				<div class="tabla__contenedor">
					<div class="tabla__cabecera" aria-hidden="true">
						<span>#</span>
						<span>Equipo</span>
						<span>DG</span>
						<span>Pts</span>
					</div>
					<ol class="tabla__filas">
						{teams.map((team) => (
							<li>
								<details class="tabla__fila">
									<summary>
										<span class:list={['tabla__pos', { 'tabla__pos--lider': team.pos === 1 }]}>
											{team.pos}
										</span>
										<span class="tabla__equipo">
											<ClubLogo logo={team.logo} size={32} />
											<span class="tabla__equipo-texto">
												<span class="tabla__nombre">{team.equipo_nombre}</span>
												{team.pos <= 2 && <span class="tabla__regional"></span>}
											</span>
										</span>
										<span class="tabla__dg">
											{team.dg > 0 ? `+${team.dg}` : team.dg}
										</span>
										<span class="tabla__pts">{team.pts}</span>
									</summary>
									<div class="tabla__detalle">
										<span>PJ <b>{team.pj}</b></span>
										<span>G <b>{team.g}</b></span>
										<span>E <b>{team.e}</b></span>
										<span>P <b>{team.p}</b></span>
										<span>GF <b>{team.gf}</b></span>
										<span>GC <b>{team.gc}</b></span>
									</div>
								</details>
							</li>
						))}
					</ol>
					<p class="tabla__nota">Clasificados al Regional</p>
				</div>
			) : (
				<p class="tabla__vacio">No hay datos de posiciones disponibles.</p>
			)
		}
	</div>
</section>

<style>
	.tabla {
		padding: var(--spacing-xl) 0 var(--spacing-2xl);
	}

	.tabla__titulo {
		margin-bottom: var(--spacing-lg);
		font-family: var(--font-headline);
		font-size: 1.6rem;
		font-weight: 400;
		text-transform: uppercase;
		color: var(--color-neutral);
	}

	.tabla__contenedor {
		--escudo-size: 26px;
		padding: 0 var(--spacing-sm) var(--spacing-sm);
		background: rgba(255, 255, 255, 0.015);
		border: 1px solid var(--color-line);
		border-radius: var(--border-radius-sm);
		overflow: hidden;
	}

	.tabla__cabecera,
	.tabla__fila summary {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) 3rem 2.75rem;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.tabla__cabecera {
		margin: 0 calc(var(--spacing-sm) * -1);
		padding: var(--spacing-sm);
		font-family: var(--font-body);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-secondary);
		background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid var(--color-line);
	}

	.tabla__cabecera span:nth-child(n + 3),
	.tabla__dg,
	.tabla__pts {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.tabla__filas {
		list-style: none;
	}

	.tabla__filas li + li .tabla__fila {
		border-top: 1px solid var(--color-line);
	}

	.tabla__fila summary {
		padding: var(--spacing-sm) 0;
		cursor: pointer;
		list-style: none;
	}

	.tabla__fila summary::-webkit-details-marker {
		display: none;
	}

	.tabla__pos {
		font-family: var(--font-body);
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
		color: var(--color-secondary);
	}

	.tabla__pos--lider {
		font-family: var(--font-headline);
		font-size: 1.5rem;
		line-height: 1;
		color: var(--color-primary);
	}

	.tabla__equipo {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		min-width: 0;
	}

	.tabla__equipo-texto {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
		min-width: 0;
	}

	.tabla__nombre {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-neutral);
		overflow-wrap: break-word;
	}

	.tabla__regional {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-body);
		font-size: 0.6rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-secondary);
		white-space: nowrap;
	}

	.tabla__regional::before {
		content: '';
		width: 5px;
		height: 5px;
		background: var(--color-primary);
	}

	.tabla__dg {
		font-family: var(--font-body);
		font-size: 0.85rem;
		color: var(--color-secondary);
	}

	.tabla__pts {
		font-family: var(--font-headline);
		font-size: 1.25rem;
		line-height: 1;
		color: var(--color-neutral);
	}

	.tabla__detalle {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm) var(--spacing-lg);
		padding: 0 0 var(--spacing-md) calc(2rem + var(--spacing-sm) * 2 + var(--escudo-size));
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-secondary);
	}

	.tabla__detalle b {
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--color-neutral);
	}

	.tabla__nota {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		margin: 0 calc(var(--spacing-sm) * -1) calc(var(--spacing-sm) * -1);
		padding: var(--spacing-sm);
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-secondary);
		background: rgba(255, 255, 255, 0.03);
		border-top: 1px solid var(--color-line);
	}

	.tabla__nota::before {
		content: '';
		width: 6px;
		height: 6px;
		flex-shrink: 0;
		background: var(--color-primary);
	}

	.tabla__vacio {
		padding: var(--spacing-xl) 0;
		color: var(--color-secondary);
	}

	@media (min-width: 768px) {
		.tabla__contenedor {
			--escudo-size: 32px;
			padding: 0 var(--spacing-md) var(--spacing-md);
		}

		.tabla {
			padding: var(--spacing-2xl) 0;
		}

		.tabla__titulo {
			font-size: 2rem;
		}

		.tabla__cabecera,
		.tabla__fila summary {
			grid-template-columns: 3rem minmax(0, 1fr) 4rem 4rem;
		}

		.tabla__cabecera,
		.tabla__nota {
			margin-left: calc(var(--spacing-md) * -1);
			margin-right: calc(var(--spacing-md) * -1);
			padding-left: var(--spacing-md);
			padding-right: var(--spacing-md);
		}

		.tabla__nota {
			margin-bottom: calc(var(--spacing-md) * -1);
		}

		.tabla__fila summary {
			padding: var(--spacing-md) 0;
		}

		.tabla__equipo-texto {
			flex-direction: row;
			align-items: baseline;
			gap: var(--spacing-sm);
		}

		.tabla__nombre {
			font-size: 1.05rem;
		}

		.tabla__pts {
			font-size: 1.5rem;
		}

		.tabla__detalle {
			padding-left: calc(3rem + var(--spacing-sm) * 2 + var(--escudo-size));
			font-size: 0.85rem;
		}
	}
</style>
