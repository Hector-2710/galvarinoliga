---
export interface Props {
	title: string;
	activeRoute: 'dashboard' | 'partidos' | 'equipos' | 'jugadores' | 'jornadas' | 'temporadas' | 'goleadores' | 'asistencias';
	adminName?: string;
}

const { title, activeRoute, adminName = 'Admin' } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} - Admin Galvarino Liga</title>
		<style is:global>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body { font-family: system-ui, -apple-system, sans-serif; background: #fff; color: #222; min-height: 100vh; }
			a { color: #1a73e8; }
			a:hover { color: #1557b0; }

			/* Header */
			.admin-header { background: #1a1a2e; color: #fff; padding: 0.75rem 1.5rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
			.admin-header h1 { font-size: 1.1rem; }
			.admin-user { font-size: 0.8rem; color: #aaa; margin-right: 1rem; }
			.btn-logout { background: transparent; border: 1px solid #666; color: #ccc; padding: 0.35rem 0.75rem; border-radius: 4px; cursor: pointer; font-size: 0.8rem; }
			.btn-logout:hover { border-color: #e61e2a; color: #e61e2a; }

			/* Nav */
			.admin-nav { background: #f0f0f0; padding: 0.5rem 1.5rem; display: flex; gap: 1rem; border-bottom: 1px solid #ddd; flex-wrap: wrap; }
			.admin-nav a { color: #555; text-decoration: none; font-size: 0.85rem; padding: 0.25rem 0; border-bottom: 2px solid transparent; }
			.admin-nav a:hover, .admin-nav a.active { color: #1a1a2e; border-bottom-color: #e61e2a; }

			/* Content */
			.admin-content { padding: 1.5rem; max-width: 1200px; margin: 0 auto; }

			/* Page header */
			.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
			.page-header h2 { font-size: 1.3rem; color: #1a1a2e; }

			/* Buttons */
			.btn { display: inline-block; padding: 0.45rem 0.9rem; background: #1a73e8; color: #fff; border: none; border-radius: 4px; font-size: 0.85rem; text-decoration: none; cursor: pointer; }
			.btn:hover { background: #1557b0; }
			.btn-sm { padding: 0.3rem 0.6rem; font-size: 0.75rem; }
			.btn-danger { background: #d32f2f; }
			.btn-danger:hover { background: #b71c1c; }
			.btn-secondary { background: transparent; border: 1px solid #999; color: #555; }
			.btn-secondary:hover { border-color: #333; color: #333; background: #f5f5f5; }

			/* Tables */
			.table-wrapper { overflow-x: auto; border: 1px solid #ddd; border-radius: 4px; }
			table { width: 100%; border-collapse: collapse; }
			th { background: #f5f5f5; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: #666; padding: 0.6rem 0.8rem; text-align: left; border-bottom: 2px solid #ddd; }
			td { padding: 0.5rem 0.8rem; font-size: 0.85rem; border-bottom: 1px solid #eee; }
			tr:last-child td { border-bottom: none; }
			tr:hover td { background: #fafafa; }

			/* Estado badges */
			.estado-badge { display: inline-block; padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; }
			.estado-programado { background: #e0e0e0; color: #555; }
			.estado-en_vivo { background: #ffebee; color: #d32f2f; }
			.estado-finalizado { background: #e8f5e9; color: #2e7d32; }

			/* Empty state */
			.empty-state { text-align: center; padding: 2rem; color: #999; font-size: 0.9rem; }

			/* Forms */
			.form-card { background: #fafafa; border: 1px solid #ddd; border-radius: 4px; padding: 1.5rem; margin-bottom: 1rem; }
			.form-group { margin-bottom: 0.8rem; }
			.form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #444; margin-bottom: 0.25rem; }
			.form-group input, .form-group select, .form-group textarea { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.85rem; font-family: inherit; color: #222; background: #fff; }
			.form-group input:focus, .form-group select:focus { border-color: #1a73e8; outline: none; }
			.form-group select { background: #fff; }
			.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
			.form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
			.form-actions { display: flex; gap: 0.8rem; margin-top: 1rem; }
			.error-msg { background: #ffebee; border: 1px solid #ef9a9a; border-radius: 4px; padding: 0.6rem 0.8rem; margin-bottom: 0.8rem; font-size: 0.85rem; color: #c62828; }
			.success-msg { background: #e8f5e9; border: 1px solid #a5d6a7; border-radius: 4px; padding: 0.6rem 0.8rem; margin-bottom: 0.8rem; font-size: 0.85rem; color: #2e7d32; }

			/* Section divider */
			.section-divider { border: none; border-top: 1px solid #ddd; margin: 1rem 0; }
			.section-title { font-size: 0.85rem; font-weight: 600; text-transform: uppercase; color: #666; margin-bottom: 0.8rem; }

			/* Sub-sections (inline lists) */
			.sub-section { margin-top: 1rem; }
			.inline-list { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.5rem; }
			.inline-item { display: flex; justify-content: space-between; align-items: center; padding: 0.4rem 0.6rem; background: #fff; border: 1px solid #e0e0e0; border-radius: 4px; font-size: 0.85rem; }
			.inline-item small { color: #888; }
			.inline-add { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }
			.inline-add input, .inline-add select { padding: 0.4rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.8rem; background: #fff; }

			/* Marcador */
			.marcador { font-weight: 700; font-size: 1rem; }

			/* Dashboard stats */
			.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
			.stat-card { background: #fafafa; border: 1px solid #ddd; border-radius: 4px; padding: 1.2rem; }
			.stat-number { font-size: 1.8rem; font-weight: 700; color: #1a73e8; }
			.stat-label { font-size: 0.75rem; color: #888; text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.2rem; }
			.quick-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
			.quick-actions-title { font-size: 0.85rem; font-weight: 600; color: #666; margin-bottom: 0.8rem; text-transform: uppercase; }

			/* Team section grid */
			.team-section { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.8rem; }
			@media (max-width: 700px) { .team-section { grid-template-columns: 1fr; } }
			.team-goles h4 { font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 0.4rem; }
			.badge { display: inline-block; padding: 0.15rem 0.4rem; border-radius: 3px; font-size: 0.7rem; font-weight: 600; margin-right: 0.3rem; }
			.badge-gol { background: #e8f5e9; color: #2e7d32; }

			/* Back link */
			.back-link { color: #1a73e8; font-size: 0.85rem; text-decoration: none; display: inline-block; margin-bottom: 0.5rem; }
			.back-link:hover { text-decoration: underline; }

			/* Misc */
			.marcador-display { text-align: center; padding: 1rem; font-size: 2rem; font-weight: 700; letter-spacing: 0.06em; }
		</style>
	</head>
	<body>
		<header class="admin-header">
			<h1>Galvarino Liga - Admin</h1>
			<div>
				<span class="admin-user">{adminName}</span>
				<form method="POST" action="/api/auth/logout" style="display:inline;">
					<button type="submit" class="btn-logout">Cerrar Sesion</button>
				</form>
			</div>
		</header>

		<nav class="admin-nav">
			<a href="/admin" class:list={{ active: activeRoute === 'dashboard' }}>Dashboard</a>
			<a href="/admin/partidos" class:list={{ active: activeRoute === 'partidos' }}>Partidos</a>
			<a href="/admin/equipos" class:list={{ active: activeRoute === 'equipos' }}>Equipos</a>
			<a href="/admin/jugadores" class:list={{ active: activeRoute === 'jugadores' }}>Jugadores</a>
			<a href="/admin/jornadas" class:list={{ active: activeRoute === 'jornadas' }}>Jornadas</a>
			<a href="/admin/temporadas" class:list={{ active: activeRoute === 'temporadas' }}>Temporadas</a>
			<a href="/admin/goleadores" class:list={{ active: activeRoute === 'goleadores' }}>Goleadores</a>
			<a href="/admin/asistencias" class:list={{ active: activeRoute === 'asistencias' }}>Asistencias</a>
		</nav>

		<main class="admin-content">
			<slot />
		</main>

		<script>
			document.querySelector('form[action="/api/auth/logout"]')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const res = await fetch('/api/auth/logout', { method: 'POST' });
				if (res.ok) window.location.href = '/admin/login';
			});
		</script>
	</body>
</html>
