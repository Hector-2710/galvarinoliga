---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import MatchRow from "../components/MatchRow.astro";
import Footer from "../components/Footer.astro";
import { getJornadas } from "../lib/liga";

const jornadas = (await getJornadas()).filter((jornada) => jornada.partidos.length > 0);

const fechaCorta = new Intl.DateTimeFormat('es-CL', {
	weekday: 'short',
	day: 'numeric',
	month: 'short',
});

function dia(fecha: string): Date {
	return new Date(`${fecha}T12:00:00`);
}
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="fixture">
			<div class="container">
				<h1 class="page-title">Jornadas</h1>
				<p class="page-subtitle">Calendario y resultados de la temporada</p>

				{
					jornadas.length === 0 ? (
						<p class="vacio">En espera del comienzo de la temporada.</p>
					) : (
						jornadas.map((jornada) => (
							<section class="jornada">
								<div class="jornada__cabecera">
									<h2 class="jornada__titulo">
										<span>Jornada</span>
										<span class="jornada__numero">{jornada.numero}</span>
									</h2>
									<p class="jornada__fecha">{fechaCorta.format(dia(jornada.fecha_inicio))}</p>
								</div>
								<ol class="jornada__partidos">
									{jornada.partidos.map((partido) => (
										<li>
											<MatchRow
												partido={partido}
												href={`/partidos/${partido.slug}`}
											/>
										</li>
									))}
								</ol>
							</section>
						))
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.fixture {
		padding: var(--spacing-xl) 0 var(--spacing-2xl);
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: clamp(2.5rem, 10vw, 3.2rem);
		font-weight: 400;
		line-height: 1;
		text-transform: uppercase;
		color: var(--color-neutral);
	}

	.page-subtitle {
		margin: var(--spacing-sm) 0 var(--spacing-2xl);
		font-family: var(--font-body);
		font-size: 0.95rem;
		color: var(--color-secondary);
	}

	.vacio {
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
	}

	.jornada {
		padding: var(--spacing-xl) 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.jornada:first-of-type {
		border-top: 2px solid var(--color-primary);
	}

	.jornada__cabecera {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--spacing-sm) var(--spacing-lg);
		margin-bottom: var(--spacing-md);
	}

	.jornada__titulo {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-sm);
		font-family: var(--font-headline);
		font-size: 1.1rem;
		font-weight: 400;
		text-transform: uppercase;
		color: var(--color-secondary);
	}

	.jornada__numero {
		font-size: 2.5rem;
		line-height: 0.8;
		color: var(--color-neutral);
	}

	.jornada__fecha {
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-secondary);
	}

	.jornada__partidos {
		display: flex;
		flex-direction: column;
	}

	.jornada__partidos li + li :global(.fila) {
		border-top: 1px solid rgba(255, 255, 255, 0.11);
	}

	@media (min-width: 1024px) {
		.fixture {
			padding: var(--spacing-2xl) 0;
		}

		.page-subtitle {
			font-size: 1rem;
		}

		.jornada {
			padding: var(--spacing-2xl) 0;
		}

		.jornada__titulo {
			font-size: 1.4rem;
		}

		.jornada__numero {
			font-size: 3.5rem;
		}

		.jornada__fecha {
			font-size: 0.9rem;
		}
	}
</style>
