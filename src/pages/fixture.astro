---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SponsorsBanners from "../components/SponsorsBanners.astro";
import Footer from "../components/Footer.astro";
import { createServerSupabase } from "../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: jornadas } = await supabase
	.from("jornadas")
	.select(
		`
		id,
		numero,
		nombre,
		fecha_inicio,
		fecha_fin,
		partidos(
			id,
			fecha,
			hora,
			cancha,
			goles1,
			goles2,
			estado,
			equipo1:equipo1_id(nombre),
			equipo2:equipo2_id(nombre)
		)
	`,
	)
	.order("numero", { ascending: true });

interface MatchData {
	id: number;
	fecha: string;
	hora: string | null;
	cancha: string;
	goles1: number | null;
	goles2: number | null;
	estado: string;
	equipo1: { nombre: string } | { nombre: string }[] | null;
	equipo2: { nombre: string } | { nombre: string }[] | null;
}

interface NormalizedMatch {
	id: number;
	equipo1: string;
	equipo2: string;
	fecha: string;
	hora: string;
	cancha: string;
	goles1: number | null;
	goles2: number | null;
	estado: string;
}

interface JornadaGroup {
	id: number;
	numero: number;
	nombre: string;
	fecha_inicio: string | null;
	fecha_fin: string | null;
	partidos: NormalizedMatch[];
	total: number;
	finalizados: number;
	programados: number;
	en_vivo: number;
}

function normalizeEquipo(
	eq: { nombre: string } | { nombre: string }[] | null,
): string {
	if (!eq) return "—";
	if (Array.isArray(eq)) return eq[0]?.nombre ?? "—";
	return eq.nombre;
}

function normalizeMatch(m: MatchData): NormalizedMatch {
	return {
		id: m.id,
		equipo1: normalizeEquipo(m.equipo1),
		equipo2: normalizeEquipo(m.equipo2),
		fecha: m.fecha,
		hora: m.hora?.slice(0, 5) ?? "",
		cancha: m.cancha,
		goles1: m.goles1,
		goles2: m.goles2,
		estado: m.estado,
	};
}

function formatFecha(fechaStr: string): string {
	const fecha = new Date(fechaStr + "T12:00:00");
	const dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
	const meses = [
		"Ene",
		"Feb",
		"Mar",
		"Abr",
		"May",
		"Jun",
		"Jul",
		"Ago",
		"Sep",
		"Oct",
		"Nov",
		"Dic",
	];
	return `${dias[fecha.getDay()]} ${fecha.getDate()} ${meses[fecha.getMonth()]}`;
}

function estadoLabel(estado: string): string {
	switch (estado) {
		case "programado":
			return "Programado";
		case "en_vivo":
			return "En Vivo";
		case "finalizado":
			return "Finalizado";
		default:
			return estado;
	}
}

function isFechaPasada(fechaStr: string): boolean {
	return fechaStr < new Date().toISOString().split("T")[0];
}

const fixture: JornadaGroup[] = (jornadas ?? [])
	.filter((j) => (j.partidos ?? []).length > 0)
	.map((j) => {
		const partidos = (j.partidos as MatchData[] | undefined ?? [])
			.map(normalizeMatch)
			.sort((a, b) => a.fecha.localeCompare(b.fecha) || a.hora.localeCompare(b.hora));
		return {
			id: j.id,
			numero: j.numero,
			nombre: j.nombre,
			fecha_inicio: j.fecha_inicio,
			fecha_fin: j.fecha_fin,
			partidos,
			total: partidos.length,
			finalizados: partidos.filter((p) => p.estado === "finalizado").length,
			programados: partidos.filter((p) => p.estado === "programado").length,
			en_vivo: partidos.filter((p) => p.estado === "en_vivo").length,
		};
	});
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="fixture">
			<div class="container">
				<h1 class="page-title fade-in-up">Fixture</h1>
				<p class="page-subtitle fade-in-up">Calendario y resultados de la temporada</p>

				{
					fixture.length === 0 ? (
						<div class="empty-state">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							<p>En espera del comienzo de la temporada.</p>
						</div>
					) : (
						<>
							{
								fixture.map((jornada, gi) => {
									const isCompleta = jornada.finalizados === jornada.total && jornada.total > 0;
									const isProxima = !isCompleta && jornada.programados > 0 && (gi === 0 || fixture[gi - 1]?.finalizados === fixture[gi - 1]?.total);
									return (
										<div
											class:list={{
												"jornada-group": true,
												"jornada-group--completa": isCompleta,
												"jornada-group--proxima": isProxima && !isCompleta,
												"jornada-group--envivo": jornada.en_vivo > 0,
											}}
											style={`animation-delay: ${gi * 0.08}s`}
										>
											<div class="jornada-header">
												<div class="jornada-header__left">
													<h2 class="jornada-title">
														<span class:list={{
															"jornada-badge": true,
															"jornada-badge--completa": isCompleta,
															"jornada-badge--envivo": jornada.en_vivo > 0,
														}}>{jornada.numero}</span>
														{jornada.nombre}
													</h2>
													{jornada.fecha_inicio && (
														<span class="jornada-date">
															<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
																<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
																<line x1="16" y1="2" x2="16" y2="6"></line>
																<line x1="8" y1="2" x2="8" y2="6"></line>
																<line x1="3" y1="10" x2="21" y2="10"></line>
															</svg>
															{formatFecha(jornada.fecha_inicio)}
															{jornada.fecha_fin && ` — ${formatFecha(jornada.fecha_fin)}`}
														</span>
													)}
												</div>
												<div class="jornada-stats">
													{jornada.finalizados > 0 && (
														<span class="jornada-stat jornada-stat--finalizado">
															{jornada.finalizados} Finalizado{jornada.finalizados !== 1 ? "s" : ""}
														</span>
													)}
													{jornada.en_vivo > 0 && (
														<span class="jornada-stat jornada-stat--envivo">
															<span class="live-dot"></span>
															{jornada.en_vivo} En Vivo
														</span>
													)}
													{jornada.programados > 0 && (
														<span class="jornada-stat jornada-stat--programado">
															{jornada.programados} Programado{jornada.programados !== 1 ? "s" : ""}
														</span>
													)}
												</div>
											</div>

											<div class="matches__list">
												{
													jornada.partidos.map((match, mi) => (
														<article
															class:list={{
																"match-card": true,
																"match-card--finalizado": match.estado === "finalizado",
																"match-card--envivo": match.estado === "en_vivo",
																"match-card--pasado": match.estado === "programado" && isFechaPasada(match.fecha),
															}}
															style={`animation-delay: ${(gi * 0.08) + ((mi + 1) * 0.06)}s`}
														>
															<div class="match-card__header">
																<span class="match-card__date">
																	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
																		<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
																		<line x1="16" y1="2" x2="16" y2="6"></line>
																		<line x1="8" y1="2" x2="8" y2="6"></line>
																		<line x1="3" y1="10" x2="21" y2="10"></line>
																	</svg>
																	{formatFecha(match.fecha)}
																</span>
																<span class="match-card__time">
																	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
																		<circle cx="12" cy="12" r="10"></circle>
																		<polyline points="12 6 12 12 16 14"></polyline>
																	</svg>
																	{match.hora}
																</span>
																{match.estado !== "programado" && (
																	<span class:list={{
																		"match-card__estado": true,
																		"match-card__estado--envivo": match.estado === "en_vivo",
																		"match-card__estado--finalizado": match.estado === "finalizado",
																	}}>
																		{match.estado === "en_vivo" && <span class="live-dot"></span>}
																		{estadoLabel(match.estado)}
																	</span>
																)}
															</div>

															<div class="match-card__body">
																<div class="match-card__team match-card__team--local">
																	<span class="match-card__team-name">{match.equipo1}</span>
																</div>

																{match.estado === "finalizado" ? (
																	<div class="match-card__score">
																		<span class:list={{
																			"match-card__goal": true,
																			"match-card__goal--winner": match.goles1 !== null && match.goles2 !== null && match.goles1 > match.goles2,
																		}}>{match.goles1}</span>
																		<span class="match-card__score-sep">-</span>
																		<span class:list={{
																			"match-card__goal": true,
																			"match-card__goal--winner": match.goles1 !== null && match.goles2 !== null && match.goles2 > match.goles1,
																		}}>{match.goles2}</span>
																	</div>
																) : match.estado === "en_vivo" ? (
																	<div class="match-card__score match-card__score--envivo">
																		{match.goles1 !== null ? match.goles1 : "?"}
																		<span class="match-card__score-sep">-</span>
																		{match.goles2 !== null ? match.goles2 : "?"}
																	</div>
																) : (
																	<div class="match-card__vs">
																		<span class="match-card__vs-text">VS</span>
																	</div>
																)}

																<div class="match-card__team match-card__team--visita">
																	<span class="match-card__team-name">{match.equipo2}</span>
																</div>
															</div>

															<div class="match-card__footer">
																<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
																	<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
																	<circle cx="12" cy="10" r="3"></circle>
																</svg>
																{match.cancha}
															</div>
														</article>
													))
												}
											</div>
										</div>
									);
								})
							}

						</>
					)
				}
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	.fixture {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-xl);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	/* ===== Jornada Group ===== */
	.jornada-group {
		margin-bottom: var(--spacing-2xl);
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}

	.jornada-group--completa {
		border-left: 4px solid #22c55e;
	}

	.jornada-group--proxima {
		border-left: 4px solid var(--color-primary);
	}

	.jornada-group--envivo {
		border-left: 4px solid var(--color-primary-light);
		animation: pulse-border 2s ease-in-out infinite;
	}

	@keyframes pulse-border {
		0%, 100% {
			border-left-color: var(--color-primary-light);
		}
		50% {
			border-left-color: rgba(255, 58, 69, 0.4);
		}
	}

	.jornada-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-sm);
		padding: var(--spacing-md);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.jornada-header__left {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--spacing-md);
		min-width: 0;
	}

	.jornada-title {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-headline);
		font-size: 1.1rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
	}

	.jornada-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-neutral);
		font-family: var(--font-label);
		font-size: 0.85rem;
		font-weight: 700;
		box-shadow: var(--shadow-red);
		flex-shrink: 0;
	}

	.jornada-badge--completa {
		background: #22c55e;
		box-shadow: 0 4px 16px rgba(34, 197, 94, 0.25);
	}

	.jornada-badge--envivo {
		background: var(--color-primary-light);
	}

	.jornada-date {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.jornada-date svg {
		flex-shrink: 0;
	}

	/* ===== Jornada Stats ===== */
	.jornada-stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs);
	}

	.jornada-stat {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 2px 8px;
		border-radius: 20px;
		background: rgba(168, 173, 179, 0.1);
		color: var(--color-secondary);
	}

	.jornada-stat--finalizado {
		background: rgba(34, 197, 94, 0.12);
		color: #4ade80;
	}

	.jornada-stat--envivo {
		background: rgba(230, 30, 42, 0.15);
		color: var(--color-primary-light);
	}

	.live-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-primary-light);
		animation: pulse 1s ease-in-out infinite;
	}

	/* ===== Matches List ===== */
	.matches__list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		padding: var(--spacing-md);
	}

	/* ===== Match Card ===== */
	.match-card {
		background: rgba(255, 255, 255, 0.02);
		border-radius: var(--border-radius-lg);
		padding: var(--spacing-md);
		border: 1px solid rgba(255, 255, 255, 0.04);
		position: relative;
		overflow: hidden;
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}

	.match-card::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 3px;
		height: 100%;
		background: var(--color-secondary);
		opacity: 0.3;
		border-radius: 0 2px 2px 0;
	}

	.match-card--finalizado::before {
		background: #22c55e;
		opacity: 1;
	}

	.match-card--envivo::before {
		background: var(--color-primary-light);
		opacity: 1;
		animation: pulse-border 2s ease-in-out infinite;
	}

	.match-card--pasado {
		opacity: 0.55;
	}

	.match-card:active {
		transform: scale(0.98);
	}

	/* ===== Match Card Header ===== */
	.match-card__header {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-sm);
		padding-left: var(--spacing-xs);
	}

	.match-card__date,
	.match-card__time {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.match-card__date svg,
	.match-card__time svg,
	.match-card__footer svg {
		flex-shrink: 0;
	}

	.match-card__estado {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.55rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 2px 8px;
		border-radius: 20px;
		background: rgba(168, 173, 179, 0.15);
		color: var(--color-secondary);
	}

	.match-card__estado--envivo {
		background: rgba(230, 30, 42, 0.15);
		color: var(--color-primary-light);
	}

	.match-card__estado--finalizado {
		background: rgba(34, 197, 94, 0.12);
		color: #4ade80;
	}

	/* ===== Match Card Body ===== */
	.match-card__body {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--spacing-sm) 0;
		gap: var(--spacing-sm);
	}

	.match-card__team {
		flex: 1;
		min-width: 0;
	}

	.match-card__team--local {
		text-align: right;
	}

	.match-card__team--visita {
		text-align: left;
	}

	.match-card__team-name {
		font-family: var(--font-headline);
		font-size: 0.85rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* ===== VS Badge ===== */
	.match-card__vs {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		border-radius: 50%;
		box-shadow: var(--shadow-red);
	}

	.match-card__vs-text {
		font-family: var(--font-headline);
		font-size: 0.8rem;
		color: var(--color-neutral);
		letter-spacing: 0.04em;
	}

	/* ===== Score ===== */
	.match-card__score {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-headline);
		font-size: 1.3rem;
		color: var(--color-neutral);
		min-width: 52px;
		justify-content: center;
	}

	.match-card__score--envivo {
		color: var(--color-primary-light);
	}

	.match-card__score-sep {
		color: var(--color-secondary);
		font-size: 0.85rem;
	}

	.match-card__goal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 22px;
	}

	.match-card__goal--winner {
		color: #4ade80;
		font-weight: 700;
	}

	/* ===== Match Card Footer ===== */
	.match-card__footer {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		padding-left: var(--spacing-xs);
		margin-top: var(--spacing-xs);
	}

	/* ===== Tablet (≥640px) ===== */
	@media (min-width: 640px) {
		.fixture {
