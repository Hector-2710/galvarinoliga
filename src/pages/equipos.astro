---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { createServerSupabase } from "../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: equipos } = await supabase
	.from("equipos")
	.select("id, nombre, ano_creacion, logo_url, presidente, secretaria, tesorera, color_principal")
	.order("nombre");

const { data: jugadoresCount } = await supabase
	.from("jugadores")
	.select("equipo_id");

const playerCountMap = new Map<number, number>();
for (const j of jugadoresCount ?? []) {
	const equipoId = j.equipo_id as number;
	playerCountMap.set(equipoId, (playerCountMap.get(equipoId) ?? 0) + 1);
}

interface TeamRow {
	id: number;
	nombre: string;
	anoCreacion: number | null;
	logoUrl: string | null;
	presidente: string | null;
	colorPrincipal: string;
	jugadoresCount: number;
}

const teams: TeamRow[] = (equipos ?? []).map((eq) => ({
	id: eq.id,
	nombre: eq.nombre,
	anoCreacion: eq.ano_creacion,
	logoUrl: eq.logo_url,
	presidente: eq.presidente,
	colorPrincipal: eq.color_principal ?? "#E61E2A",
	jugadoresCount: playerCountMap.get(eq.id) ?? 0,
}));
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="equipos">
			<div class="container">
				<h1 class="page-title fade-in-up">Equipos</h1>
				<p class="page-subtitle fade-in-up">Conoce los equipos que pertenecen a la asociación de Galvarino</p>

				{
					teams.length === 0 ? (
						<div class="empty-state">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M16.24 7.76a6 6 0 0 1 0 8.49"></path>
								<path d="M7.76 7.76a6 6 0 0 0 0 8.49"></path>
							</svg>
							<p>No hay equipos registrados todavía.</p>
						</div>
					) : (
						<div class="equipos-list">
							{
								teams.map((team, i) => (
									<a
										href={`/equipos/stats?id=${team.id}`}
										class="team-row fade-in-up"
										style={`animation-delay: ${i * 0.08}s`}
									>
										<div
											class="team-row__accent"
											style={`background-color: ${team.colorPrincipal}`}
										></div>

										{team.logoUrl ? (
											<img
												src={team.logoUrl}
												alt={`Logo de ${team.nombre}`}
												class="team-row__logo"
												loading="lazy"
											/>
										) : (
											<div
												class="team-row__logo-placeholder"
												style={`background-color: ${team.colorPrincipal}`}
											>
												<span class="team-row__logo-initial">{team.nombre.charAt(0)}</span>
											</div>
										)}

										<div class="team-row__info">
											<h2 class="team-row__name">{team.nombre}</h2>
											{team.anoCreacion && (
												<span class="team-row__ano">Fundado {team.anoCreacion}</span>
											)}
										</div>

										{team.presidente && (
											<div class="team-row__presidente">
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
													<circle cx="12" cy="7" r="4"></circle>
												</svg>
												<span class="team-row__presidente-text">{team.presidente}</span>
											</div>
										)}

										<div class="team-row__meta">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
												<circle cx="9" cy="7" r="4"></circle>
												<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
												<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
											</svg>
											<span>{team.jugadoresCount} jugador{team.jugadoresCount !== 1 ? "es" : ""}</span>
										</div>

										<div class="team-row__arrow">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="9 18 15 12 9 6"></polyline>
											</svg>
										</div>
									</a>
								))
							}
						</div>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.equipos {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-lg);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	.equipos-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.team-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		transition: transform 0.2s, border-color 0.2s;
		cursor: pointer;
		padding: var(--spacing-sm) var(--spacing-md);
		min-height: 60px;
		position: relative;
		overflow: hidden;
	}

	.team-row:active {
		transform: scale(0.99);
	}

	.team-row__accent {
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 4px;
		border-radius: var(--border-radius-lg) 0 0 var(--border-radius-lg);
		flex-shrink: 0;
	}

	.team-row__logo {
		width: 40px;
		height: 40px;
		object-fit: contain;
		border-radius: var(--border-radius-sm);
		flex-shrink: 0;
	}

	.team-row__logo-placeholder {
		width: 40px;
		height: 40px;
		border-radius: var(--border-radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.team-row__logo-initial {
		font-family: var(--font-headline);
		font-size: 1.2rem;
		color: var(--color-neutral);
		text-transform: uppercase;
	}

	.team-row__info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.team-row__name {
		font-family: var(--font-headline);
		font-size: 1rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.team-row__ano {
		font-family: var(--font-label);
		font-size: 0.65rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.team-row__presidente {
		display: none;
		align-items: center;
		gap: 6px;
		flex-shrink: 0;
		max-width: 160px;
	}

	.team-row__presidente svg {
		opacity: 0.5;
		flex-shrink: 0;
	}

	.team-row__presidente-text {
		font-family: var(--font-label);
		font-size: 0.75rem;
		color: var(--color-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.team-row__meta {
		display: none;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		flex-shrink: 0;
	}

	.team-row__meta svg {
		opacity: 0.5;
		flex-shrink: 0;
	}

	.team-row__arrow {
		display: flex;
		align-items: center;
		color: var(--color-secondary);
		opacity: 0.4;
		flex-shrink: 0;
		transition: opacity 0.2s, transform 0.2s;
	}

	@media (min-width: 640px) {
		.equipos {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}

		.team-row {
			padding: var(--spacing-md) var(--spacing-lg);
			gap: var(--spacing-md);
			min-height: 68px;
		}

		.team-row__accent {
			width: 5px;
		}

		.team-row__logo,
		.team-row__logo-placeholder {
			width: 48px;
			height: 48px;
		}

		.team-row__logo-initial {
			font-size: 1.4rem;
		}

		.team-row__name {
			font-size: 1.1rem;
		}

		.team-row__presidente {
			display: flex;
		}

		.team-row__meta {
			display: flex;
		}
	}

	@media (min-width: 1024px) {
		.equipos {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-xl);
		}

		.equipos-list {
			gap: var(--spacing-md);
		}

		.team-row {
			padding: var(--spacing-lg) var(--spacing-xl);
			gap: var(--spacing-lg);
			min-height: 76px;
			transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
		}

		.team-row:hover {
			transform: translateX(4px);
			box-shadow: var(--shadow-lg);
			border-color: rgba(230, 30, 42, 0.3);
		}

		.team-row:hover .team-row__arrow {
			opacity: 1;
			transform: translateX(4px);
		}

		.team-row:active {
			transform: scale(0.98);
		}

		.team-row__accent {
			width: 5px;
		}

		.team-row__logo,
		.team-row__logo-placeholder {
			width: 56px;
			height: 56px;
		}

		.team-row__logo-initial {
			font-size: 1.6rem;
		}

		.team-row__name {
			font-size: 1.25rem;
		}

		.team-row__meta {
			font-size: 0.75rem;
		}

		.team-row__presidente {
			max-width: 200px;
		}

		.team-row__arrow {
			opacity: 0.3;
		}
	}

	@media (min-width: 1280px) {
		.page-title {
			font-size: 3.2rem;
		}

		.team-row {
			gap: var(--spacing-xl);
		}

		.team-row__name {
			font-size: 1.3rem;
		}

		.team-row__presidente {
			max-width: 240px;
		}
	}
</style>
