---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ClubLogo from "../components/ClubLogo.astro";
import { getEquipos } from "../lib/liga";

interface TeamRow {
	slug: string;
	nombre: string;
	anoCreacion?: number;
	logoUrl?: string;
}

const teams: TeamRow[] = (await getEquipos()).map((equipo) => ({
	slug: equipo.slug,
	nombre: equipo.nombre,
	anoCreacion: equipo.ano_creacion,
	logoUrl: equipo.logo,
}));
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="equipos">
			<div class="container">
				<h1 class="page-title">Equipos</h1>
				<p class="page-subtitle">Conoce los equipos que pertenecen a la asociación de Galvarino</p>

				{
					teams.length === 0 ? (
						<div class="empty-state">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M16.24 7.76a6 6 0 0 1 0 8.49"></path>
								<path d="M7.76 7.76a6 6 0 0 0 0 8.49"></path>
							</svg>
							<p>No hay equipos registrados todavía.</p>
						</div>
					) : (
						<div class="equipos-list">
							{
								teams.map((team) => (
									<a
										href={`/equipos/${team.slug}`}
										class="team-row"
									>
										<span class="team-row__logo">
											<ClubLogo logo={team.logoUrl} size={52} />
										</span>

										<div class="team-row__info">
											<h2 class="team-row__name">{team.nombre}</h2>
											{team.anoCreacion && (
												<span class="team-row__ano">Fundado {team.anoCreacion}</span>
											)}
										</div>

										<div class="team-row__club-link">
											<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<circle cx="12" cy="12" r="10"></circle>
												<path d="M12 16v-4"></path>
												<path d="M12 8h.01"></path>
											</svg>
											<span>Ver información del club</span>
										</div>

										<div class="team-row__arrow">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
												<polyline points="9 18 15 12 9 6"></polyline>
											</svg>
										</div>
									</a>
								))
							}
						</div>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.equipos {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-lg);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	.equipos-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.team-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		background: var(--color-tertiary);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		text-decoration: none;
		transition: transform 0.2s, border-color 0.2s;
		cursor: pointer;
		padding: var(--spacing-sm) var(--spacing-md);
		min-height: 60px;
		position: relative;
		overflow: hidden;
	}

	.team-row:active {
		transform: scale(0.99);
	}

	.team-row__logo {
		--escudo-size: 40px;
		display: inline-flex;
		flex-shrink: 0;
	}

	.team-row__info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.team-row__name {
		font-family: var(--font-headline);
		font-size: 1rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.team-row__ano {
		font-family: var(--font-body);
		font-size: 0.65rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.team-row__club-link {
		display: none;
		align-items: center;
		gap: 6px;
		font-family: var(--font-body);
		font-size: 0.7rem;
		color: var(--color-primary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		flex-shrink: 0;
		white-space: nowrap;
	}

	.team-row__club-link svg {
		flex-shrink: 0;
		opacity: 0.7;
	}

	.team-row__arrow {
		display: flex;
		align-items: center;
		color: var(--color-secondary);
		opacity: 0.4;
		flex-shrink: 0;
		transition: opacity 0.2s, transform 0.2s;
	}

	@media (min-width: 640px) {
		.equipos {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}

		.team-row {
			padding: var(--spacing-md) var(--spacing-lg);
			gap: var(--spacing-md);
			min-height: 68px;
		}

		.team-row__logo {
			--escudo-size: 44px;
		}

		.team-row__name {
			font-size: 1.1rem;
		}

		.team-row__club-link {
			display: flex;
		}
	}

	@media (min-width: 1024px) {
		.equipos {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-xl);
		}

		.equipos-list {
			gap: var(--spacing-md);
		}

		.team-row {
			padding: var(--spacing-lg) var(--spacing-xl);
			gap: var(--spacing-lg);
			min-height: 76px;
			transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
		}

		.team-row:hover {
			transform: translateX(4px);
			border-color: rgba(230, 30, 42, 0.3);
		}

		.team-row:hover .team-row__arrow {
			opacity: 1;
			transform: translateX(4px);
		}

		.team-row:active {
			transform: scale(0.98);
		}

		.team-row__logo {
			--escudo-size: 52px;
		}

		.team-row__name {
			font-size: 1.25rem;
		}

		.team-row__club-link {
			font-size: 0.75rem;
		}

		.team-row__arrow {
			opacity: 0.3;
		}
	}

	@media (min-width: 1280px) {
		.page-title {
			font-size: 3.2rem;
		}

		.team-row {
			gap: var(--spacing-xl);
		}

		.team-row__name {
			font-size: 1.3rem;
		}

		.team-row__club-link {
			font-size: 0.8rem;
		}
	}
</style>
