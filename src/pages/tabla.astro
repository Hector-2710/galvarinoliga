---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SponsorsBanners from "../components/SponsorsBanners.astro";
import Footer from "../components/Footer.astro";
import StandingsTable from "../components/StandingsTable.astro";
import { calcularTabla } from "../lib/liga";

const standings = (await calcularTabla()).map((fila) => ({
	pos: fila.pos,
	equipo_nombre: fila.equipo.nombre,
	pj: fila.pj,
	g: fila.g,
	e: fila.e,
	p: fila.p,
	gf: fila.gf,
	gc: fila.gc,
	dg: fila.dg,
	pts: fila.pts,
}));
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="tabla">
			<div class="container">
				<h1 class="page-title fade-in-up">Tabla de Posiciones</h1>
				<p class="page-subtitle fade-in-up">Revisa la clasificación actualizada de todos los equipos de la liga comunal en Galvarino</p>

				{
					standings.length > 0 ? (
						<StandingsTable teams={standings} />
					) : (
						<div class="empty-state">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
								<polyline points="14 2 14 8 20 8"></polyline>
								<line x1="16" y1="13" x2="8" y2="13"></line>
								<line x1="16" y1="17" x2="8" y2="17"></line>
							</svg>
							<p>No hay datos de posiciones disponibles. Espera al inicio de la temporada.</p>
						</div>
					)
				}
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	.tabla {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-lg);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	@media (min-width: 640px) {
		.tabla {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}
	}

	@media (min-width: 1024px) {
		.tabla {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-xl);
		}
	}

	@media (min-width: 1280px) {
		.page-title {
			font-size: 3.2rem;
		}
	}
</style>
