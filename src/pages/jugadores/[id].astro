---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SponsorsBanners from "../../components/SponsorsBanners.astro";
import Footer from "../../components/Footer.astro";
import { createServerSupabase } from "../../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
	return Astro.redirect("/equipos");
}

// --- Fetch player with team info ---
const { data: jugador, error: jugadorError } = await supabase
	.from("jugadores")
	.select(`
		id, nombre, apellido, fecha_nacimiento, posicion, numero_camiseta, foto_url, activo,
		equipo:equipo_id(id, nombre, logo_url, color_principal)
	`)
	.eq("id", id)
	.single();

if (jugadorError || !jugador) {
	return Astro.redirect("/equipos");
}

// --- Fetch player goals with match details ---
const { data: golesData } = await supabase
	.from("goles")
	.select(`
		id,
		partido:partido_id(
			id, fecha, estado,
			equipo1:equipo1_id(nombre, logo_url),
			equipo2:equipo2_id(nombre, logo_url),
			goles1, goles2
		)
	`)
	.eq("jugador_id", Number(id))
	.order("id", { ascending: false });

// --- Fetch assists from vista ---
const { data: asistData } = await supabase
	.from("vista_asistidores")
	.select("asistencias")
	.eq("jugador_id", Number(id))
	.maybeSingle();

// --- Interfaces ---
interface EquipoRef {
	id: number;
	nombre: string;
	logo_url: string | null;
	color_principal: string | null;
}

interface JugadorData {
	id: number;
	nombre: string;
	apellido: string;
	fecha_nacimiento: string | null;
	posicion: string | null;
	numero_camiseta: number | null;
	foto_url: string | null;
	activo: boolean;
	equipo: EquipoRef | EquipoRef[] | null;
}

interface PartidoRef {
	id: number;
	fecha: string;
	estado: string;
	equipo1: { nombre: string; logo_url: string | null } | { nombre: string; logo_url: string | null }[] | null;
	equipo2: { nombre: string; logo_url: string | null } | { nombre: string; logo_url: string | null }[] | null;
	goles1: number | null;
	goles2: number | null;
}

interface GolData {
	id: number;
	partido: PartidoRef | PartidoRef[] | null;
}

// --- Normalize helpers ---
function normalizeEquipo(eq: EquipoRef | EquipoRef[] | null): EquipoRef | null {
	if (!eq) return null;
	if (Array.isArray(eq)) return eq[0] ?? null;
	return eq;
}

function normalizePartido(p: PartidoRef | PartidoRef[] | null): PartidoRef | null {
	if (!p) return null;
	if (Array.isArray(p)) return p[0] ?? null;
	return p;
}

const equipo = normalizeEquipo(jugador.equipo as EquipoRef | EquipoRef[] | null);
const colorPrincipal = equipo?.color_principal ?? "#E61E2A";

// --- Compute age ---
function calcularEdad(fechaNacimiento: string | null): number | null {
	if (!fechaNacimiento) return null;
	const hoy = new Date();
	const nacimiento = new Date(fechaNacimiento + "T12:00:00");
	let edad = hoy.getFullYear() - nacimiento.getFullYear();
	const mesActual = hoy.getMonth();
	const diaActual = hoy.getDate();
	const mesNacimiento = nacimiento.getMonth();
	const diaNacimiento = nacimiento.getDate();
	if (mesActual < mesNacimiento || (mesActual === mesNacimiento && diaActual < diaNacimiento)) {
		edad--;
	}
	return edad;
}

const edad = calcularEdad(jugador.fecha_nacimiento);

// --- Position helpers ---
function posicionIcono(posicion: string | null): string {
	switch (posicion) {
		case "Arquero": return "🧤";
		case "Defensa": return "🛡️";
		case "Mediocampista": return "⚡";
		case "Delantero": return "⚽";
		default: return "👕";
	}
}

// --- Goals ---
const goles: GolData[] = (golesData ?? []) as GolData[];
const totalGoles = goles.length;

// --- Assists ---
const totalAsistencias = asistData?.asistencias ?? 0;

// --- Match history (unique matches where player scored) ---
interface PartidoHistorial {
	id: number;
	fecha: string;
	estado: string;
	equipo1Nombre: string;
	equipo2Nombre: string;
	goles1: number | null;
	goles2: number | null;
}

const partidosMap = new Map<number, PartidoHistorial>();
for (const g of goles) {
	const partido = normalizePartido(g.partido as PartidoRef | PartidoRef[] | null);
	if (partido && !partidosMap.has(partido.id)) {
		const eq1 = normalizeEquipo(partido.equipo1 as unknown as EquipoRef | EquipoRef[] | null);
		const eq2 = normalizeEquipo(partido.equipo2 as unknown as EquipoRef | EquipoRef[] | null);
		partidosMap.set(partido.id, {
			id: partido.id,
			fecha: partido.fecha,
			estado: partido.estado,
			equipo1Nombre: eq1?.nombre ?? "—",
			equipo2Nombre: eq2?.nombre ?? "—",
			goles1: partido.goles1,
			goles2: partido.goles2,
		});
	}
}
const historialPartidos: PartidoHistorial[] = Array.from(partidosMap.values());

// --- Formatting ---
function formatFecha(fechaStr: string): string {
	const fecha = new Date(fechaStr + "T12:00:00");
	const meses = [
		"Ene", "Feb", "Mar", "Abr", "May", "Jun",
		"Jul", "Ago", "Sep", "Oct", "Nov", "Dic",
	];
	return `${fecha.getDate()} ${meses[fecha.getMonth()]} ${fecha.getFullYear()}`;
}

function estadoLabel(estado: string): string {
	switch (estado) {
		case "programado": return "Programado";
		case "en_vivo": return "En Vivo";
		case "finalizado": return "Finalizado";
		default: return estado;
	}
}

function formatFechaNacimiento(fecha: string | null): string {
	if (!fecha) return "—";
	const d = new Date(fecha + "T12:00:00");
	const meses = [
		"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
		"Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
	];
	return `${d.getDate()} de ${meses[d.getMonth()]} ${d.getFullYear()}`;
}
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="player-profile">
			<div class="container">
				<a href={equipo ? `/equipos/stats?id=${equipo.id}` : "/equipos"} class="back-link fade-in-up">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					{equipo ? `Volver a ${equipo.nombre}` : "Volver a Equipos"}
				</a>

				{/* --- Player Header Card --- */}
				<div class="player-header fade-in-up">
					<div class="player-header__photo-wrap" style={`border-color: ${colorPrincipal}`}>
						{jugador.foto_url ? (
							<img src={jugador.foto_url} alt={`${jugador.nombre} ${jugador.apellido}`} class="player-header__photo" />
						) : (
							<div class="player-header__photo-placeholder" style={`background-color: ${colorPrincipal}20; color: ${colorPrincipal}`}>
								<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
							</div>
						)}
						{jugador.numero_camiseta && (
							<span class="player-header__jersey" style={`background-color: ${colorPrincipal}`}>
								{jugador.numero_camiseta}
							</span>
						)}
					</div>

					<div class="player-header__info">
						<h1 class="player-header__name">{jugador.nombre} {jugador.apellido}</h1>
						<div class="player-header__meta">
							{equipo && (
								<a href={`/equipos/stats?id=${equipo.id}`} class="player-header__team" style={`color: ${colorPrincipal}`}>
									{equipo.logo_url ? (
										<img src={equipo.logo_url} alt={equipo.nombre} class="player-header__team-logo" />
									) : (
										<span class="player-header__team-initial">{equipo.nombre.charAt(0)}</span>
									)}
									{equipo.nombre}
								</a>
							)}
							<span class="player-header__position">
								<span class="player-header__position-icon">{posicionIcono(jugador.posicion)}</span>
								{jugador.posicion ?? "Sin posición"}
							</span>
							{edad !== null && (
								<span class="player-header__age">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
										<line x1="16" y1="2" x2="16" y2="6"></line>
										<line x1="8" y1="2" x2="8" y2="6"></line>
										<line x1="3" y1="10" x2="21" y2="10"></line>
									</svg>
									{edad} {edad === 1 ? "año" : "años"}
								</span>
							)}
						</div>
					</div>
				</div>

				{/* --- Personal Data Card --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title">Datos Personales</h2>
					<div class="info-grid">
						<div class="info-item">
							<span class="info-item__label">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
									<circle cx="12" cy="7" r="4"></circle>
								</svg>
								Nombre Completo
							</span>
							<span class="info-item__value">{jugador.nombre} {jugador.apellido}</span>
						</div>
						<div class="info-item">
							<span class="info-item__label">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
									<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
								</svg>
								Posición
							</span>
							<span class="info-item__value">{posicionIcono(jugador.posicion)} {jugador.posicion ?? "No registrada"}</span>
						</div>
						{jugador.numero_camiseta && (
							<div class="info-item">
								<span class="info-item__label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="8" x2="12" y2="16"></line>
										<line x1="8" y1="12" x2="16" y2="12"></line>
									</svg>
									Número de Camiseta
								</span>
								<span class="info-item__value info-item__value--jersey">#{jugador.numero_camiseta}</span>
							</div>
						)}
						<div class="info-item">
							<span class="info-item__label">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
								Fecha de Nacimiento
							</span>
							<span class="info-item__value">{formatFechaNacimiento(jugador.fecha_nacimiento)}</span>
						</div>
						{edad !== null && (
							<div class="info-item">
								<span class="info-item__label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<polyline points="12 6 12 12 16 14"></polyline>
									</svg>
									Edad
								</span>
								<span class="info-item__value">{edad} {edad === 1 ? "año" : "años"}</span>
							</div>
						)}
						{equipo && (
							<div class="info-item">
								<span class="info-item__label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
										<circle cx="9" cy="7" r="4"></circle>
										<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
										<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
									</svg>
									Equipo
								</span>
								<span class="info-item__value">
									<a href={`/equipos/stats?id=${equipo.id}`} class="info-item__link" style={`color: ${colorPrincipal}`}>{equipo.nombre}</a>
								</span>
							</div>
						)}
					</div>
				</div>

				{/* --- Season Stats Card --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title">Estadísticas de Temporada</h2>
					<div class="stats-grid">
						<div class="stat-box">
							<span class="stat-box__value stat-box__value--goals">{totalGoles}</span>
							<span class="stat-box__label">Goles</span>
						</div>
						<div class="stat-box">
							<span class="stat-box__value stat-box__value--assists">{totalAsistencias}</span>
							<span class="stat-box__label">Asistencias</span>
						</div>
						<div class="stat-box">
							<span class="stat-box__value">{historialPartidos.length}</span>
							<span class="stat-box__label">Partidos con Gol</span>
						</div>
					</div>
					{totalGoles === 0 && totalAsistencias === 0 && (
						<p class="empty-text">Este jugador aún no tiene estadísticas registradas en la temporada.</p>
					)}
				</div>

				{/* --- Match History Card --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title">Historial de Partidos</h2>
					{historialPartidos.length === 0 ? (
						<p class="empty-text">Este jugador aún no tiene partidos registrados.</p>
					) : (
						<div class="matches-list">
							{historialPartidos.map((p) => (
								<a href={`/partidos/${p.id}`} class="match-row">
									<div class="match-row__date">
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
											<line x1="16" y1="2" x2="16" y2="6"></line>
											<line x1="8" y1="2" x2="8" y2="6"></line>
											<line x1="3" y1="10" x2="21" y2="10"></line>
										</svg>
										{formatFecha(p.fecha)}
									</div>
									<div class="match-row__teams">
										<span class="match-row__team-name">{p.equipo1Nombre}</span>
										<span class="match-row__score">
											{p.goles1 ?? "?"} - {p.goles2 ?? "?"}
										</span>
										<span class="match-row__team-name">{p.equipo2Nombre}</span>
									</div>
									<span class:list={{
										"match-row__estado": true,
										"match-row__estado--finalizado": p.estado === "finalizado",
										"match-row__estado--envivo": p.estado === "en_vivo",
										"match-row__estado--programado": p.estado === "programado",
									}}>
										{p.estado === "en_vivo" && <span class="live-dot"></span>}
										{estadoLabel(p.estado)}
									</span>
								</a>
							))}
						</div>
					)}
				</div>
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	/* ================================================
	   Base (Mobile First) — < 640px
	   ================================================ */
	.player-profile {
		padding: var(--spacing-lg) 0;
	}

	/* ---- Back Link ---- */
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		font-family: var(--font-label);
		font-size: 0.8rem;
		color: var(--color-secondary);
		text-decoration: none;
		margin-bottom: var(--spacing-lg);
		transition: color 0.2s ease, gap 0.2s ease;
		padding: var(--spacing-sm) 0;
		min-height: 44px;
		-webkit-tap-highlight-color: transparent;
		border-radius: var(--border-radius-sm);
	}

	.back-link svg {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	@media (hover: hover) {
		.back-link:hover {
			color: var(--color-neutral);
			gap: var(--spacing-sm);
		}

		.back-link:hover svg {
			transform: translateX(-3px);
		}
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	/* ---- Player Header Card ---- */
	.player-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-lg);
		padding: var(--spacing-xl);
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		margin-bottom: var(--spacing-xl);
		text-align: center;
	}

	.player-header__photo-wrap {
		position: relative;
		width: 120px;
		height: 120px;
		border-radius: 50%;
		border: 3px solid;
		overflow: hidden;
		flex-shrink: 0;
		background: var(--color-tertiary);
	}

	.player-header__photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.player-header__photo-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.player-header__jersey {
		position: absolute;
		bottom: -2px;
		right: -2px;
		min-width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--border-radius-sm);
		font-family: var(--font-headline);
		font-size: 1rem;
		color: var(--color-neutral);
		box-shadow: var(--shadow-md);
		padding: 0 var(--spacing-sm);
	}

	.player-header__info {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		min-width: 0;
	}

	.player-header__name {
		font-family: var(--font-headline);
		font-size: 1.6rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
	}

	.player-header__meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--spacing-md);
	}

	.player-header__team {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-label);
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: opacity 0.2s;
	}

	@media (hover: hover) {
		.player-header__team:hover {
			opacity: 0.8;
		}
	}

	.player-header__team-logo {
		width: 20px;
		height: 20px;
		object-fit: contain;
		border-radius: 4px;
	}

	.player-header__team-initial {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		border-radius: 4px;
		background: rgba(255, 255, 255, 0.1);
		font-family: var(--font-headline);
		font-size: 0.7rem;
		color: var(--color-neutral);
	}

	.player-header__position {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.75rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.player-header__position-icon {
		font-size: 0.9rem;
	}

	.player-header__age {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.75rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.player-header__age svg {
		opacity: 0.5;
		flex-shrink: 0;
	}

	/* ---- Section Card ---- */
	.section-card {
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.section-card__title {
		font-family: var(--font-headline);
		font-size: 1.05rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-md);
		padding-bottom: var(--spacing-sm);
		border-bottom: 2px solid var(--color-primary);
