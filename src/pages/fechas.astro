---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { createServerSupabase } from "../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: jornadas } = await supabase
	.from("jornadas")
	.select(
		`
		id,
		numero,
		nombre,
		fecha_inicio,
		fecha_fin,
		partidos(
			id,
			fecha,
			hora,
			cancha,
			goles1,
			goles2,
			estado,
			equipo1:equipo1_id(nombre),
			equipo2:equipo2_id(nombre)
		)
	`,
	)
	.order("numero", { ascending: true });

interface MatchData {
	id: number;
	fecha: string;
	hora: string | null;
	cancha: string;
	goles1: number | null;
	goles2: number | null;
	estado: string;
	equipo1: { nombre: string } | { nombre: string }[] | null;
	equipo2: { nombre: string } | { nombre: string }[] | null;
}

interface NormalizedMatch {
	id: number;
	equipo1: string;
	equipo2: string;
	fecha: string;
	hora: string;
	cancha: string;
	goles1: number | null;
	goles2: number | null;
	estado: string;
}

interface JornadaConStats {
	id: number;
	numero: number;
	nombre: string;
	fecha_inicio: string | null;
	fecha_fin: string | null;
	partidos: NormalizedMatch[];
	total: number;
	finalizados: number;
	programados: number;
	en_vivo: number;
}

function normalizeEquipo(
	eq: { nombre: string } | { nombre: string }[] | null,
): string {
	if (!eq) return "—";
	if (Array.isArray(eq)) return eq[0]?.nombre ?? "—";
	return eq.nombre;
}

function normalizeMatch(m: MatchData): NormalizedMatch {
	return {
		id: m.id,
		equipo1: normalizeEquipo(m.equipo1),
		equipo2: normalizeEquipo(m.equipo2),
		fecha: m.fecha,
		hora: m.hora?.slice(0, 5) ?? "",
		cancha: m.cancha,
		goles1: m.goles1,
		goles2: m.goles2,
		estado: m.estado,
	};
}

function formatFecha(fechaStr: string): string {
	const fecha = new Date(fechaStr + "T12:00:00");
	const dias = ["Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb"];
	const meses = [
		"Ene",
		"Feb",
		"Mar",
		"Abr",
		"May",
		"Jun",
		"Jul",
		"Ago",
		"Sep",
		"Oct",
		"Nov",
		"Dic",
	];
	return `${dias[fecha.getDay()]} ${fecha.getDate()} ${meses[fecha.getMonth()]}`;
}

function estadoLabel(estado: string): string {
	switch (estado) {
		case "programado":
			return "Programado";
		case "en_vivo":
			return "En Vivo";
		case "finalizado":
			return "Finalizado";
		default:
			return estado;
	}
}

function isFechaPasada(fechaStr: string): boolean {
	return fechaStr < new Date().toISOString().split("T")[0];
}

const jornadasConStats: JornadaConStats[] = (jornadas ?? [])
	.filter((j) => (j.partidos ?? []).length > 0)
	.map((j) => {
		const partidos = (j.partidos as MatchData[] | undefined ?? [])
			.map(normalizeMatch)
			.sort((a, b) => a.fecha.localeCompare(b.fecha) || a.hora.localeCompare(b.hora));
		return {
			id: j.id,
			numero: j.numero,
			nombre: j.nombre,
			fecha_inicio: j.fecha_inicio,
			fecha_fin: j.fecha_fin,
			partidos,
			total: partidos.length,
			finalizados: partidos.filter((p) => p.estado === "finalizado").length,
			programados: partidos.filter((p) => p.estado === "programado").length,
			en_vivo: partidos.filter((p) => p.estado === "en_vivo").length,
		};
	});

---

<Layout>
	<Header />
	<main class="main-content">
		<section class="fechas">
			<div class="container">
				<h1 class="page-title fade-in-up">Fechas</h1>
				<p class="page-subtitle fade-in-up">Todas las jornadas de la temporada</p>

				{
					jornadasConStats.length === 0 ? (
						<div class="empty-state">
							<svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							<p>En espera del comienzo de la temporada.</p>
						</div>
					) : (
						<div class="jornadas-list">
							{
								jornadasConStats.map((jornada, ji) => {
									const isCompleta = jornada.finalizados === jornada.total && jornada.total > 0;
									const isProxima = !isCompleta && jornada.programados > 0 && (ji === 0 || jornadasConStats[ji - 1]?.finalizados === jornadasConStats[ji - 1]?.total);
									return (
										<article
											class:list={{
												"jornada-card": true,
												"jornada-card--completa": isCompleta,
												"jornada-card--proxima": isProxima && !isCompleta,
												"jornada-card--envivo": jornada.en_vivo > 0,
											}}
											style={`animation-delay: ${ji * 0.08}s`}
										>
											<div class="jornada-card__header">
												<div class="jornada-card__title-row">
													<span class="jornada-card__badge">{jornada.numero}</span>
													<div class="jornada-card__info">
														<h2 class="jornada-card__name">{jornada.nombre}</h2>
														{jornada.fecha_inicio && (
															<span class="jornada-card__date">
																<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
																	<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
																	<line x1="16" y1="2" x2="16" y2="6"></line>
																	<line x1="8" y1="2" x2="8" y2="6"></line>
																	<line x1="3" y1="10" x2="21" y2="10"></line>
																</svg>
																{formatFecha(jornada.fecha_inicio)}
																{jornada.fecha_fin && ` — ${formatFecha(jornada.fecha_fin)}`}
															</span>
														)}
													</div>
												</div>
												<div class="jornada-card__stats">
													<span class:list={{
														"jornada-card__stat-badge": true,
														"jornada-card__stat-badge--finalizado": true,
														"jornada-card__stat-badge--active": jornada.finalizados > 0,
													}}>
														{jornada.finalizados} Finalizado{jornada.finalizados !== 1 ? "s" : ""}
													</span>
													{jornada.en_vivo > 0 && (
														<span class="jornada-card__stat-badge jornada-card__stat-badge--envivo">
															<span class="live-dot"></span>
															{jornada.en_vivo} En Vivo
														</span>
													)}
													{jornada.programados > 0 && (
														<span class="jornada-card__stat-badge jornada-card__stat-badge--programado">
															{jornada.programados} Programado{jornada.programados !== 1 ? "s" : ""}
														</span>
													)}
												</div>
											</div>

											<div class="jornada-card__matches">
												{
													jornada.partidos.map((match) => (
														<div
															class:list={{
																"match-row": true,
																"match-row--finalizado": match.estado === "finalizado",
																"match-row--envivo": match.estado === "en_vivo",
																"match-row--pasado": match.estado === "programado" && isFechaPasada(match.fecha),
															}}
														>
															<div class="match-row__teams">
																<span class="match-row__team match-row__team--local">{match.equipo1}</span>
																<span class="match-row__vs">vs</span>
																<span class="match-row__team match-row__team--visita">{match.equipo2}</span>
															</div>

															<div class="match-row__score">
																{match.estado === "finalizado" ? (
																	<span class="match-row__score-value">
																		<span class:list={{
																			"match-row__goal": true,
																			"match-row__goal--winner": match.goles1 !== null && match.goles2 !== null && match.goles1 > match.goles2,
																		}}>{match.goles1}</span>
																		<span class="match-row__score-sep">-</span>
																		<span class:list={{
																			"match-row__goal": true,
																			"match-row__goal--winner": match.goles1 !== null && match.goles2 !== null && match.goles2 > match.goles1,
																		}}>{match.goles2}</span>
																	</span>
																) : match.estado === "en_vivo" ? (
																	<span class="match-row__score-value match-row__score-value--envivo">
																		{match.goles1 !== null ? match.goles1 : "?"}
																		<span class="match-row__score-sep">-</span>
																		{match.goles2 !== null ? match.goles2 : "?"}
																	</span>
																) : (
																	<span class="match-row__vs-text">VS</span>
																)}
															</div>

															<div class="match-row__info">
																<span class="match-row__date">
																	{formatFecha(match.fecha)}
																</span>
																{match.hora && (
																	<span class="match-row__time">{match.hora}</span>
																)}
																<span class="match-row__cancha">{match.cancha}</span>
															</div>

															<span class:list={{
																"match-row__estado": true,
																"match-row__estado--envivo": match.estado === "en_vivo",
																"match-row__estado--finalizado": match.estado === "finalizado",
															}}>
																{match.estado === "en_vivo" && (
																	<span class="live-dot"></span>
																)}
																{estadoLabel(match.estado)}
															</span>
														</div>
													))
												}
											</div>
										</article>
									);
								})
							}
						</div>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.fechas {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-lg);
	}

	/* ===== Empty State ===== */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	/* ===== Jornada Card ===== */
	.jornada-card {
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		margin-bottom: var(--spacing-lg);
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}

	.jornada-card:active {
		transform: scale(0.99);
	}

	.jornada-card--completa {
		border-left: 4px solid #22c55e;
	}

	.jornada-card--proxima {
		border-left: 4px solid var(--color-primary);
	}

	.jornada-card--envivo {
		border-left: 4px solid var(--color-primary-light);
		animation: pulse-border 2s ease-in-out infinite;
	}

	@keyframes pulse-border {
		0%, 100% {
			border-left-color: var(--color-primary-light);
		}
		50% {
			border-left-color: rgba(255, 58, 69, 0.4);
		}
	}

	/* ===== Jornada Header ===== */
	.jornada-card__header {
		padding: var(--spacing-md);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.jornada-card__title-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-sm);
	}

	.jornada-card__badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-neutral);
		font-family: var(--font-label);
		font-size: 0.95rem;
		font-weight: 700;
		box-shadow: var(--shadow-red);
		flex-shrink: 0;
	}

	.jornada-card--completa .jornada-card__badge {
		background: #22c55e;
		box-shadow: 0 4px 16px rgba(34, 197, 94, 0.25);
	}

	.jornada-card--envivo .jornada-card__badge {
		background: var(--color-primary-light);
	}

	.jornada-card__info {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.jornada-card__name {
		font-family: var(--font-headline);
		font-size: 1.1rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
	}

	.jornada-card__date {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.jornada-card__date svg {
		flex-shrink: 0;
	}

	/* ===== Jornada Stats ===== */
	.jornada-card__stats {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs);
	}

	.jornada-card__stat-badge {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 2px 8px;
		border-radius: 20px;
		color: var(--color-secondary);
		background: rgba(168, 173, 179, 0.1);
		opacity: 0.5;
	}

	.jornada-card__stat-badge--active {
		opacity: 1;
	}

	.jornada-card__stat-badge--finalizado.jornada-card__stat-badge--active {
		background: rgba(34, 197, 94, 0.12);
		color: #4ade80;
	}

	.jornada-card__stat-badge--envivo {
		background: rgba(230, 30, 42, 0.15);
		color: var(--color-primary-light);
		opacity: 1;
	}

	.jornada-card__stat-badge--programado {
		opacity: 0.7;
	}

	.live-dot {
		display: inline-block;
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-primary-light);
		animation: pulse 1s ease-in-out infinite;
	}

	/* ===== Match Row ===== */
	.jornada-card__matches {
		padding: var(--spacing-sm) var(--spacing-md);
	}

	.match-row {
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-sm) 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
		transition: opacity 0.2s;
	}

	.match-row:last-child {
		border-bottom: none;
	}

	.match-row--pasado {
		opacity: 0.5;
	}

	/* Teams */
	.match-row__teams {
		display: flex;
		align-items: center;
		gap: var(--spacing-xs);
		min-width: 0;
	}

	.match-row__team {
		font-family: var(--font-headline);
		font-size: 0.8rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.match-row__team--local {
		text-align: right;
	}

	.match-row__team--visita {
		text-align: left;
	}

	.match-row__vs {
		font-family: var(--font-label);
		font-size: 0.6rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		flex-shrink: 0;
	}

	/* Score */
	.match-row__score {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 50px;
		flex-shrink: 0;
	}

	.match-row__score-value {
		display: flex;
		align-items: center;
		gap: 3px;
		font-family: var(--font-headline);
		font-size: 1rem;
		color: var(--color-neutral);
	}

	.match-row__score-value--envivo {
		color: var(--color-primary-light);
	}

	.match-row__score-sep {
		color: var(--color-secondary);
		font-size: 0.75rem;
	}

	.match-row__goal {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 20px;
		padding: 1px 3px;
	}

	.match-row__goal--winner {
		color: #4ade80;
		font-weight: 700;
	}

	.match-row__vs-text {
		font-family: var(--font-headline);
		font-size: 0.75rem;
		color: var(--color-secondary);
		letter-spacing: 0.04em;
	}

	/* Info */
	.match-row__info {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-label);
		font-size: 0.65rem;
		color: var(--color-secondary);
		flex-shrink: 0;
	}

	.match-row__date,
	.match-row__time,
	.match-row__cancha {
		white-space: nowrap;
	}

	.match-row__cancha {
		display: none;
	}

	/* Estado */
	.match-row__estado {
		display: none;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.6rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 2px 8px;
		border-radius: 20px;
		background: rgba(168, 173, 179, 0.15);
		color: var(--color-secondary);
		flex-shrink: 0;
	}

	/* ===== Tablet (≥640px) ===== */
	@media (min-width: 640px) {
		.fechas {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}

		.stats-bar {
			padding: var(--spacing-lg);
		}

		.stat-value {
			font-size: 1.8rem;
		}

		.stat-label {
			font-size: 0.65rem;
		}

		.jornada-card__header {
			padding: var(--spacing-lg);
		}

		.jornada-card__badge {
			width: 44px;
			height: 44px;
			font-size: 1rem;
		}

		.jornada-card__name {
			font-size: 1.2rem;
		}

		.match-row {
			grid-template-columns: 1fr auto auto auto;
		}

		.match-row__estado {
			display: inline-flex;
		}

		.match-row__cancha {
			display: inline;
		}

		.match-row__team {
			font-size: 0.85rem;
		}

		.jornada-card__matches {
			padding: var(--spacing-sm) var(--spacing-lg);
		}
	}

	/* ===== Desktop (≥1024px) ===== */
	@media (min-width: 1024px) {
		.fechas {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-xl);
		}

		.stats-bar {
			padding: var(--spacing-xl);
			margin-bottom: var(--spacing-2xl);
		}

		.stat-value {
			font-size: 2rem;
		}

		.stat-label {
			font-size: 0.7rem;
		}

		.jornada-card {
			margin-bottom: var(--spacing-xl);
			transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
		}

		.jornada-card:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-lg);
			border-color: rgba(230, 30, 42, 0.3);
		}

		.jornada-card--completa:hover {
			border-color: rgba(34, 197, 94, 0.3);
		}

		.jornada-card:active {
			transform: scale(0.98);
		}

		.jornada-card__badge {
			width: 48px;
			height: 48px;
			font-size: 1.1rem;
		}

		.jornada-card__name {
			font-size: 1.3rem;
		}

		.match-row {
			padding: var(--spacing-md) 0;
