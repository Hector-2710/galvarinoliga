---
import { createServerSupabase } from '../../../lib/supabase';
import type { AstroCookies } from 'astro';

export const prerender = false;

const code = Astro.url.searchParams.get('code');
const next = Astro.url.searchParams.get('next') ?? '/admin';

if (code) {
	const supabase = createServerSupabase({
		request: Astro.request,
		cookies: Astro.cookies as unknown as AstroCookies,
	});
	const { error } = await supabase.auth.exchangeCodeForSession(code);

	if (!error) {
		return Astro.redirect(next);
	}
}

return Astro.redirect('/admin/login?error=Error al verificar el código de autenticación');
---

