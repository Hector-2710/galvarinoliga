---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: equipos } = await supabase
	.from('equipos')
	.select('id, nombre')
	.order('nombre');

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Nuevo Jugador" activeRoute="jugadores" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/jugadores" class="back-link">← Volver a Jugadores</a>
		<div class="page-header">
			<h2>Nuevo Jugador</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>

		<form class="form-card" id="jugador-form">
			<div class="form-group">
				<label for="equipo_id">Equipo *</label>
				<select id="equipo_id" name="equipo_id" required>
					<option value="">Seleccionar equipo...</option>
					{equipos?.map((eq) => (
						<option value={eq.id}>{eq.nombre}</option>
					))}
				</select>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="nombre">Nombre *</label>
					<input type="text" id="nombre" name="nombre" placeholder="Nombre" required />
				</div>
				<div class="form-group">
					<label for="apellido">Apellido *</label>
					<input type="text" id="apellido" name="apellido" placeholder="Apellido" required />
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="posicion">Posicion</label>
					<select id="posicion" name="posicion">
						<option value="">Seleccionar...</option>
						<option value="Arquero">Arquero</option>
						<option value="Defensa">Defensa</option>
						<option value="Mediocampista">Mediocampista</option>
						<option value="Delantero">Delantero</option>
					</select>
				</div>
				<div class="form-group">
					<label for="numero_camiseta">Numero Camiseta</label>
					<input type="number" id="numero_camiseta" name="numero_camiseta" min="1" max="99" placeholder="Ej: 10" />
				</div>
			</div>

			<div class="form-group">
				<label for="fecha_nacimiento">Fecha de Nacimiento</label>
				<input type="date" id="fecha_nacimiento" name="fecha_nacimiento" />
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Jugador</button>
				<a href="/admin/jugadores" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		document.getElementById('jugador-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');

			const data = {
				equipo_id: parseInt(formData.get('equipo_id')),
				nombre: formData.get('nombre'),
				apellido: formData.get('apellido'),
				posicion: formData.get('posicion') || null,
				numero_camiseta: formData.get('numero_camiseta') ? parseInt(formData.get('numero_camiseta')) : null,
				fecha_nacimiento: formData.get('fecha_nacimiento') || null,
			};

			try {
				const res = await fetch('/api/jugadores', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					window.location.href = '/admin/jugadores';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al crear jugador';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
