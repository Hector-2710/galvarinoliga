---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const [asistenciaRes, partidosRes, jugadoresRes, equiposRes] = await Promise.all([
	supabase.from('asistencias').select('*').eq('id', id).single(),
	supabase.from('partidos').select('id, fecha, temporada:temporada_id(nombre)').order('fecha', { ascending: false }),
	supabase.from('jugadores').select('id, nombre, apellido, equipo_id').order('apellido'),
	supabase.from('equipos').select('id, nombre').order('nombre'),
]);

const asistencia = asistenciaRes.data;
const partidos = partidosRes.data;
const jugadores = jugadoresRes.data;
const equipos = equiposRes.data;

if (!asistencia) {
	return Astro.redirect('/admin/asistencias');
}

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Editar Asistencia" activeRoute="asistencias" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/asistencias" class="back-link">← Volver a Asistencias</a>
		<div class="page-header">
			<h2>Editar Asistencia #{id}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<form class="form-card" id="asistencia-form" data-id={id}>
			<div class="form-group">
				<label for="partido_id">Partido</label>
				<select id="partido_id" name="partido_id">
					{partidos?.map((p) => {
						const t = p.temporada as { nombre: string } | null;
						return (
							<option value={p.id} selected={p.id === asistencia.partido_id}>{p.fecha}{t?.nombre ? ` - ${t.nombre}` : ''}</option>
						);
					})}
				</select>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="jugador_id">Jugador</label>
					<select id="jugador_id" name="jugador_id">
						{jugadores?.map((j) => (
							<option value={j.id} selected={j.id === asistencia.jugador_id} data-equipo-id={j.equipo_id}>{j.apellido}, {j.nombre}</option>
						))}
					</select>
				</div>
				<div class="form-group">
					<label for="equipo_id">Equipo</label>
					<select id="equipo_id" name="equipo_id">
						{equipos?.map((eq) => (
							<option value={eq.id} selected={eq.id === asistencia.equipo_id}>{eq.nombre}</option>
						))}
					</select>
				</div>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/asistencias" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		const asistenciaId = document.getElementById('asistencia-form').dataset.id;

		// Auto-select equipo when jugador changes
		document.getElementById('jugador_id')?.addEventListener('change', (e) => {
			const selected = e.target.selectedOptions[0];
			const equipoId = selected?.dataset.equipoId;
			if (equipoId) {
				document.getElementById('equipo_id').value = equipoId;
			}
		});

		document.getElementById('asistencia-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');
			const successMsg = document.getElementById('success-msg');

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			const data = {
				partido_id: parseInt(formData.get('partido_id')),
				jugador_id: parseInt(formData.get('jugador_id')),
				equipo_id: parseInt(formData.get('equipo_id')),
			};

			try {
				const res = await fetch(`/api/asistencias/${asistenciaId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Asistencia actualizada correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
