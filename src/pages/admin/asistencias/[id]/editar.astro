---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const [asistenciaRes, golesRes, jugadoresRes] = await Promise.all([
	supabase.from('asistencias').select('*').eq('id', id).single(),
	supabase
		.from('goles')
		.select('id, jugador:jugadores(nombre, apellido), equipo:equipos(nombre), partido:partidos(fecha, estado)')
		.order('id'),
	supabase.from('jugadores').select('id, nombre, apellido, equipo_id').order('apellido'),
]);

const asistencia = asistenciaRes.data;
const goles = golesRes.data;
const jugadores = jugadoresRes.data;

if (!asistencia) {
	return Astro.redirect('/admin/asistencias');
}

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Editar Asistencia" activeRoute="asistencias" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/asistencias" class="back-link">← Volver a Asistencias</a>
		<div class="page-header">
			<h2>Editar Asistencia #{id}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<form class="form-card" id="asistencia-form" data-id={id}>
			<div class="form-group">
				<label for="gol_id">Gol Asistido</label>
				<select id="gol_id" name="gol_id">
					{goles?.map((g) => {
						const j = g.jugador as { nombre: string; apellido: string } | null;
						const eq = g.equipo as { nombre: string } | null;
						const p = g.partido as { fecha: string; estado: string } | null;
						return (
							<option value={g.id} selected={g.id === asistencia.gol_id}>
								{eq?.nombre || '?'} — {j?.nombre} {j?.apellido}{p?.fecha ? ` (${p.fecha})` : ''}
							</option>
						);
					})}
				</select>
			</div>

			<div class="form-group">
				<label for="jugador_id">Jugador Asistidor</label>
				<select id="jugador_id" name="jugador_id">
					{jugadores?.map((j) => (
						<option value={j.id} selected={j.id === asistencia.jugador_id}>{j.apellido}, {j.nombre}</option>
					))}
				</select>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/asistencias" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		const asistenciaId = document.getElementById('asistencia-form').dataset.id;

		document.getElementById('asistencia-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');
			const successMsg = document.getElementById('success-msg');

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			const data = {
				gol_id: parseInt(formData.get('gol_id')),
				jugador_id: parseInt(formData.get('jugador_id')),
			};

			try {
				const res = await fetch(`/api/asistencias/${asistenciaId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Asistencia actualizada correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
