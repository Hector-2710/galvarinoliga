---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: asistencias } = await supabase
	.from('asistencias')
	.select('*, jugador:jugadores(nombre, apellido), gol:goles(jugador:jugadores(nombre, apellido), equipo:equipos(nombre), partido:partidos(fecha))')
	.order('id');

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Asistencias" activeRoute="asistencias" {adminName}>
	<div class="page-header">
		<h2>Asistencias</h2>
		<a href="/admin/asistencias/nuevo" class="btn">+ Nueva Asistencia</a>
	</div>

	<div class="table-wrapper">
		<table>
			<thead>
				<tr>
					<th>#</th>
					<th>Asistidor</th>
					<th>Equipo</th>
					<th>Gol de</th>
					<th>Partido</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody>
				{
					(asistencias ?? []).length > 0 ? (
						(asistencias ?? []).map((a, i: number) => {
							const j = a.jugador as { nombre: string; apellido: string } | null;
							const g = a.gol as { jugador: { nombre: string; apellido: string } | null; equipo: { nombre: string } | null; partido: { fecha: string } | null } | null;
							return (
								<tr>
									<td style="text-align:center;font-weight:700;">{i + 1}</td>
									<td><strong>{j?.nombre} {j?.apellido}</strong></td>
									<td style="color:#888;">{g?.equipo?.nombre || '—'}</td>
									<td>{g?.jugador?.nombre} {g?.jugador?.apellido}</td>
									<td style="color:#888;">{g?.partido?.fecha || '—'}</td>
									<td>
										<div style="display:flex;gap:0.4rem;">
											<a href={`/admin/asistencias/${a.id}/editar`} class="btn btn-sm">Editar</a>
											<button class="btn btn-sm btn-danger" data-delete-id={a.id}>Eliminar</button>
										</div>
									</td>
								</tr>
							);
						})
					) : (
						<tr>
							<td colspan="6">
								<div class="empty-state">No hay asistencias registradas</div>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>

	<script>
		// @ts-nocheck
		document.querySelectorAll('[data-delete-id]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.dataset.deleteId;
				if (!confirm('Estas seguro de eliminar esta asistencia?')) return;

				try {
					const res = await fetch(`/api/asistencias/${id}`, { method: 'DELETE' });
					if (res.ok) {
						window.location.reload();
					} else {
						const data = await res.json();
						alert(data.error || 'Error al eliminar');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		});
	</script>
</AdminLayout>
