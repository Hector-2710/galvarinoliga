---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: partidos } = await supabase
	.from('partidos')
	.select(`
		id, fecha, hora, cancha, goles1, goles2, estado,
		equipo1:equipo1_id(id, nombre),
		equipo2:equipo2_id(id, nombre)
	`)
	.order('fecha', { ascending: false })
	.order('hora', { ascending: false });

const adminName = Astro.locals.user?.email ?? 'Admin';

const partidosList = (partidos ?? []).map((p) => {
	const eq1 = p.equipo1 as { id: number; nombre: string } | null;
	const eq2 = p.equipo2 as { id: number; nombre: string } | null;
	return {
		...p,
		equipo1: eq1 ?? null,
		equipo2: eq2 ?? null,
	};
});
---

<AdminLayout title="Partidos" activeRoute="partidos" {adminName}>
	<div class="page-header">
		<h2>Partidos</h2>
		<a href="/admin/partidos/nuevo" class="btn">+ Nuevo Partido</a>
	</div>

	<div class="table-wrapper">
		<table>
			<thead>
				<tr>
					<th>Fecha</th>
					<th>Equipo 1</th>
					<th>Resultado</th>
					<th>Equipo 2</th>
					<th>Cancha</th>
					<th>Estado</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody>
				{
					partidosList.length > 0 ? (
						partidosList.map((p) => (
							<tr>
								<td>
									{p.fecha} {p.hora && p.hora.slice(0, 5)}
								</td>
								<td>{p.equipo1?.nombre}</td>
								<td class="marcador">
									{p.goles1 !== null ? `${p.goles1} - ${p.goles2}` : '—'}
								</td>
								<td>{p.equipo2?.nombre}</td>
								<td style="color:#888;">{p.cancha}</td>
								<td>
									<span class={`estado-badge estado-${p.estado}`}>
										{p.estado === 'programado' ? 'Programado' : p.estado === 'en_vivo' ? 'En Vivo' : 'Finalizado'}
									</span>
								</td>
								<td>
									<div style="display:flex;gap:0.4rem;">
										<a href={`/admin/partidos/${p.id}/editar`} class="btn btn-sm">Editar</a>
										<button class="btn btn-sm btn-danger" data-delete-id={p.id}>Eliminar</button>
									</div>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="7">
								<div class="empty-state">No hay partidos registrados</div>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>

	<script>
		// @ts-nocheck
		document.querySelectorAll('[data-delete-id]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.dataset.deleteId;
				if (!confirm('¿Estas seguro de eliminar este partido?')) return;

				try {
					const res = await fetch(`/api/partidos/${id}`, { method: 'DELETE' });
					if (res.ok) {
						window.location.reload();
					} else {
						const data = await res.json();
						alert(data.error || 'Error al eliminar');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		});
	</script>
</AdminLayout>
