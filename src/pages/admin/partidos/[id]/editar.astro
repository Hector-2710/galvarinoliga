---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const [partidoRes, equiposRes, jornadasRes] = await Promise.all([
	supabase.from('partidos').select('*').eq('id', id).single(),
	supabase.from('equipos').select('id, nombre').order('nombre'),
	supabase.from('jornadas').select('id, nombre, numero').order('numero'),
]);

const partido = partidoRes.data;
const equipos = equiposRes.data;
const jornadas = jornadasRes.data;

if (!partido) {
	return Astro.redirect('/admin/partidos');
}

const [golesRes, jugadoresEq1Res, jugadoresEq2Res] = await Promise.all([
	supabase.from('goles').select('*, jugador:jugador_id(nombre, apellido, numero_camiseta)').eq('partido_id', id).order('id'),
	supabase.from('jugadores').select('id, nombre, apellido, numero_camiseta').eq('equipo_id', partido.equipo1_id).order('apellido'),
	supabase.from('jugadores').select('id, nombre, apellido, numero_camiseta').eq('equipo_id', partido.equipo2_id).order('apellido'),
]);

const goles = golesRes.data ?? [];
const jugadoresEq1 = jugadoresEq1Res.data ?? [];
const jugadoresEq2 = jugadoresEq2Res.data ?? [];

const eq1Nombre = equipos?.find(e => e.id === partido.equipo1_id)?.nombre ?? 'Equipo 1';
const eq2Nombre = equipos?.find(e => e.id === partido.equipo2_id)?.nombre ?? 'Equipo 2';

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Editar Partido" activeRoute="partidos" {adminName}>
	<div style="max-width:900px;margin:0 auto;">
		<a href="/admin/partidos" class="back-link">← Volver a Partidos</a>
		<div class="page-header">
			<h2>{eq1Nombre} vs {eq2Nombre}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<!-- Informacion del Partido -->
		<form class="form-card" id="partido-form" data-id={id}>
			<h3 class="section-title">Informacion del Partido</h3>

			<div class="form-row">
				<div class="form-group">
					<label for="equipo1">Equipo 1</label>
					<select id="equipo1" name="equipo1_id">
						{equipos?.map((eq) => (
							<option value={eq.id} selected={eq.id === partido.equipo1_id}>{eq.nombre}</option>
						))}
					</select>
				</div>
				<div class="form-group">
					<label for="equipo2">Equipo 2</label>
					<select id="equipo2" name="equipo2_id">
						{equipos?.map((eq) => (
							<option value={eq.id} selected={eq.id === partido.equipo2_id}>{eq.nombre}</option>
						))}
					</select>
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="fecha">Fecha</label>
					<input type="date" id="fecha" name="fecha" value={partido.fecha} />
				</div>
				<div class="form-group">
					<label for="hora">Hora</label>
					<input type="time" id="hora" name="hora" value={partido.hora?.slice(0, 5)} />
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="cancha">Cancha</label>
					<input type="text" id="cancha" name="cancha" value={partido.cancha} />
				</div>
				<div class="form-group">
					<label for="jornada_id">Jornada</label>
					<select id="jornada_id" name="jornada_id">
						<option value="">Sin jornada</option>
						{jornadas?.map((j) => (
							<option value={j.id} selected={j.id === partido.jornada_id}>{j.nombre}</option>
						))}
					</select>
				</div>
			</div>

			<hr class="section-divider" />

			<h3 class="section-title">Resultado y Estado</h3>

			<div class="form-row-3">
				<div class="form-group">
					<label for="goles1">Goles {eq1Nombre}</label>
					<input type="number" id="goles1" name="goles1" min="0" value={partido.goles1 ?? ''} />
				</div>
				<div class="form-group">
					<label for="goles2">Goles {eq2Nombre}</label>
					<input type="number" id="goles2" name="goles2" min="0" value={partido.goles2 ?? ''} />
				</div>
				<div class="form-group">
					<label for="estado">Estado</label>
					<select id="estado" name="estado">
						<option value="programado" selected={partido.estado === 'programado'}>Programado</option>
						<option value="en_vivo" selected={partido.estado === 'en_vivo'}>En Vivo</option>
						<option value="finalizado" selected={partido.estado === 'finalizado'}>Finalizado</option>
					</select>
				</div>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/partidos" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>

		<!-- Goles -->
		<div class="form-card sub-section">
			<h3 class="section-title">Goles del Partido</h3>
			<div class="team-section">
				<div class="team-goles">
					<h4 style="color:#d32f2f;">{eq1Nombre}</h4>
					<div id="goles-eq1-list" class="inline-list">
						{goles.filter(g => g.equipo_id === partido.equipo1_id).map((gol) => {
							const jug = gol.jugador as { nombre: string; apellido: string; numero_camiseta?: number } | null;
							return (
								<div class="inline-item" data-gol-id={gol.id}>
									<div><span class="badge badge-gol">GOL</span> {jug?.nombre} {jug?.apellido} {jug?.numero_camiseta ? `(#${jug.numero_camiseta})` : ''}</div>
									<button class="btn btn-sm btn-danger" data-delete-gol={gol.id}>Quitar</button>
								</div>
							);
						})}
						{goles.filter(g => g.equipo_id === partido.equipo1_id).length === 0 && (
							<div style="color:#888;font-size:0.85rem;">Sin goles</div>
						)}
					</div>
					<div class="inline-add">
						<select id="gol-jugador-eq1" style="flex:1;">
							<option value="">Seleccionar jugador...</option>
							{jugadoresEq1.map((j) => (
								<option value={j.id}>{j.nombre} {j.apellido} {j.numero_camiseta ? `(#${j.numero_camiseta})` : ''}</option>
							))}
						</select>
						<button class="btn btn-sm" data-add-gol-equipo={partido.equipo1_id}>Agregar Gol</button>
					</div>
				</div>

				<div class="team-goles">
					<h4 style="color:#555;">{eq2Nombre}</h4>
					<div id="goles-eq2-list" class="inline-list">
						{goles.filter(g => g.equipo_id === partido.equipo2_id).map((gol) => {
							const jug = gol.jugador as { nombre: string; apellido: string; numero_camiseta?: number } | null;
							return (
								<div class="inline-item" data-gol-id={gol.id}>
									<div><span class="badge badge-gol">GOL</span> {jug?.nombre} {jug?.apellido} {jug?.numero_camiseta ? `(#${jug.numero_camiseta})` : ''}</div>
									<button class="btn btn-sm btn-danger" data-delete-gol={gol.id}>Quitar</button>
								</div>
							);
						})}
						{goles.filter(g => g.equipo_id === partido.equipo2_id).length === 0 && (
							<div style="color:#888;font-size:0.85rem;">Sin goles</div>
						)}
					</div>
					<div class="inline-add">
						<select id="gol-jugador-eq2" style="flex:1;">
							<option value="">Seleccionar jugador...</option>
							{jugadoresEq2.map((j) => (
								<option value={j.id}>{j.nombre} {j.apellido} {j.numero_camiseta ? `(#${j.numero_camiseta})` : ''}</option>
							))}
						</select>
						<button class="btn btn-sm" data-add-gol-equipo={partido.equipo2_id}>Agregar Gol</button>
					</div>
				</div>
			</div>
		</div>

	</div>

	<script>
		// @ts-nocheck
		const partidoId = document.getElementById('partido-form').dataset.id;
		const errorMsg = document.getElementById('error-msg');
		const successMsg = document.getElementById('success-msg');

		document.getElementById('partido-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			const data = {
				equipo1_id: parseInt(formData.get('equipo1_id')),
				equipo2_id: parseInt(formData.get('equipo2_id')),
				fecha: formData.get('fecha'),
				hora: formData.get('hora'),
				cancha: formData.get('cancha'),
				jornada_id: formData.get('jornada_id') ? parseInt(formData.get('jornada_id')) : null,
				goles1: formData.get('goles1') ? parseInt(formData.get('goles1')) : null,
				goles2: formData.get('goles2') ? parseInt(formData.get('goles2')) : null,
				estado: formData.get('estado'),
			};

			if (data.equipo1_id === data.equipo2_id) {
				errorMsg.textContent = 'Los equipos deben ser distintos';
				errorMsg.style.display = 'block';
				return;
			}

			try {
				const res = await fetch(`/api/partidos/${partidoId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Partido actualizado correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar partido';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});

		document.querySelectorAll('[data-add-gol-equipo]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const equipoId = parseInt(btn.dataset.addGolEquipo);
				const eq1Id = parseInt(document.querySelector('[name="equipo1_id"]')?.value);
				const selectId = equipoId === eq1Id ? 'gol-jugador-eq1' : 'gol-jugador-eq2';
				const jugadorSelect = document.getElementById(selectId);
				const jugadorId = parseInt(jugadorSelect?.value);

				if (!jugadorId) return alert('Seleccione un jugador');

				try {
					const res = await fetch('/api/goles', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ partido_id: parseInt(partidoId), jugador_id: jugadorId, equipo_id: equipoId }),
					});

					if (res.ok) {
						window.location.reload();
					} else {
						const data = await res.json();
						alert(data.error || 'Error al agregar gol');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		});

		document.querySelectorAll('[data-delete-gol]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('¿Quitar este gol?')) return;
				try {
					const res = await fetch(`/api/goles/${btn.dataset.deleteGol}`, { method: 'DELETE' });
					if (res.ok) window.location.reload();
					else alert('Error al quitar gol');
				} catch { alert('Error de conexion'); }
			});
		});

	</script>
</AdminLayout>
