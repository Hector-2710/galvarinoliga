---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: temporadas } = await supabase
	.from('temporadas')
	.select('id, nombre')
	.order('nombre');

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Nueva Jornada" activeRoute="jornadas" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/jornadas" class="back-link">← Volver a Jornadas</a>
		<div class="page-header">
			<h2>Nueva Jornada</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>

		<form class="form-card" id="jornada-form">
			<div class="form-group">
				<label for="temporada_id">Temporada *</label>
				<select id="temporada_id" name="temporada_id" required>
					<option value="">Seleccionar temporada...</option>
					{temporadas?.map((t) => (
						<option value={t.id}>{t.nombre}</option>
					))}
				</select>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="numero">Numero de Jornada *</label>
					<input type="number" id="numero" name="numero" min="1" placeholder="Ej: 1" required />
				</div>
				<div class="form-group">
					<label for="nombre">Nombre *</label>
					<input type="text" id="nombre" name="nombre" placeholder="Ej: Fecha 1" required />
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="fecha_inicio">Fecha Inicio</label>
					<input type="date" id="fecha_inicio" name="fecha_inicio" />
				</div>
				<div class="form-group">
					<label for="fecha_fin">Fecha Fin</label>
					<input type="date" id="fecha_fin" name="fecha_fin" />
				</div>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Jornada</button>
				<a href="/admin/jornadas" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		document.getElementById('jornada-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');

			const data = {
				temporada_id: parseInt(formData.get('temporada_id')),
				numero: parseInt(formData.get('numero')),
				nombre: formData.get('nombre'),
				fecha_inicio: formData.get('fecha_inicio') || null,
				fecha_fin: formData.get('fecha_fin') || null,
			};

			try {
				const res = await fetch('/api/jornadas', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					window.location.href = '/admin/jornadas';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al crear jornada';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
