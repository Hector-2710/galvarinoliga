---
export const prerender = false;

const error = Astro.url.searchParams.get('error');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin - Galvarino Liga</title>
		<style>
			* { box-sizing: border-box; margin: 0; padding: 0; }
			body { font-family: system-ui, -apple-system, sans-serif; background: #f0f0f0; color: #222; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
			.login-container { width: 100%; max-width: 380px; padding: 1.5rem; }
			.login-card { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
			.login-title { font-size: 1.3rem; text-align: center; margin-bottom: 0.25rem; color: #1a1a2e; }
			.login-subtitle { text-align: center; font-size: 0.85rem; color: #888; margin-bottom: 1.5rem; }
			.form-group { margin-bottom: 0.8rem; }
			.form-group label { display: block; font-size: 0.8rem; font-weight: 600; color: #555; margin-bottom: 0.3rem; }
			.form-group input { width: 100%; padding: 0.6rem 0.8rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; font-family: inherit; }
			.form-group input:focus { border-color: #1a73e8; outline: none; }
			.btn-submit { width: 100%; padding: 0.6rem; background: #1a73e8; color: #fff; border: none; border-radius: 4px; font-size: 0.95rem; cursor: pointer; margin-top: 0.5rem; }
			.btn-submit:hover { background: #1557b0; }
			.error-msg { background: #ffebee; border: 1px solid #ef9a9a; border-radius: 4px; padding: 0.6rem; margin-bottom: 0.8rem; font-size: 0.8rem; color: #c62828; text-align: center; }
			.back-link { display: block; text-align: center; margin-top: 1.2rem; color: #1a73e8; font-size: 0.8rem; text-decoration: none; }
			.back-link:hover { text-decoration: underline; }
		</style>
	</head>
	<body>
		<div class="login-container">
			<div class="login-card">
				<h1 class="login-title">Admin Panel</h1>
				<p class="login-subtitle">Inicia sesion para gestionar la liga</p>

				{
					error && (
						<div class="error-msg">{error}</div>
					)
				}

				<form id="login-form" method="POST">
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" placeholder="admin@ejemplo.com" required autocomplete="email" />
					</div>

					<div class="form-group">
						<label for="password">Contrasena</label>
						<input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
					</div>

					<button type="submit" class="btn-submit">Ingresar</button>
				</form>

				<a href="/" class="back-link">← Volver al sitio</a>
			</div>
		</div>

		<script>
			document.getElementById('login-form')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = /** @type {HTMLFormElement} */ (e.target);
				const formData = new FormData(form);

				try {
					const res = await fetch('/api/auth/login', {
						method: 'POST',
						body: formData,
					});

					const data = await res.json();

					if (res.ok) {
						window.location.href = '/admin';
					} else {
						alert(data.error || 'Error al iniciar sesion');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		</script>
	</body>
</html>
