---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const { data: temporada } = await supabase
	.from('temporadas')
	.select('*')
	.eq('id', id)
	.single();

if (!temporada) {
	return Astro.redirect('/admin/temporadas');
}

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Editar Temporada" activeRoute="temporadas" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/temporadas" class="back-link">← Volver a Temporadas</a>
		<div class="page-header">
			<h2>Editar: {temporada.nombre}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<form class="form-card" id="temporada-form" data-id={id}>
			<div class="form-group">
				<label for="nombre">Nombre</label>
				<input type="text" id="nombre" name="nombre" value={temporada.nombre} required />
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="fecha_inicio">Fecha Inicio</label>
					<input type="date" id="fecha_inicio" name="fecha_inicio" value={temporada.fecha_inicio} required />
				</div>
				<div class="form-group">
					<label for="fecha_fin">Fecha Fin</label>
					<input type="date" id="fecha_fin" name="fecha_fin" value={temporada.fecha_fin} required />
				</div>
			</div>

			<div class="form-group">
				<label>
					<input type="checkbox" name="activa" value="true" checked={temporada.activa === true} style="width:auto;margin-right:0.4rem;" />
					Temporada activa
				</label>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/temporadas" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		const temporadaId = document.getElementById('temporada-form').dataset.id;
		document.getElementById('temporada-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');
			const successMsg = document.getElementById('success-msg');

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			const data = {
				nombre: formData.get('nombre'),
				fecha_inicio: formData.get('fecha_inicio'),
				fecha_fin: formData.get('fecha_fin'),
				activa: formData.get('activa') === 'true',
			};

			try {
				const res = await fetch(`/api/temporadas/${temporadaId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Temporada actualizada correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
