---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: temporadas } = await supabase
	.from('temporadas')
	.select('*')
	.order('fecha_inicio', { ascending: false });

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Temporadas" activeRoute="temporadas" {adminName}>
	<div class="page-header">
		<h2>Temporadas</h2>
		<a href="/admin/temporadas/nuevo" class="btn">+ Nueva Temporada</a>
	</div>

	<div class="table-wrapper">
		<table>
			<thead>
				<tr>
					<th>Nombre</th>
					<th>Fecha Inicio</th>
					<th>Fecha Fin</th>
					<th>Estado</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody>
				{
					(temporadas ?? []).length > 0 ? (
						(temporadas ?? []).map((t) => (
							<tr>
								<td style="font-weight:600;">{t.nombre}</td>
								<td>{t.fecha_inicio}</td>
								<td>{t.fecha_fin}</td>
								<td>
									<span class={`estado-badge ${t.activa ? 'estado-finalizado' : 'estado-programado'}`}>
										{t.activa ? 'Activa' : 'Inactiva'}
									</span>
								</td>
								<td>
									<div style="display:flex;gap:0.4rem;">
										<a href={`/admin/temporadas/${t.id}/editar`} class="btn btn-sm">Editar</a>
										<button class="btn btn-sm btn-danger" data-delete-id={t.id}>Eliminar</button>
									</div>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="5">
								<div class="empty-state">No hay temporadas registradas</div>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>

	<script>
		// @ts-nocheck
		document.querySelectorAll('[data-delete-id]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.dataset.deleteId;
				if (!confirm('¿Estas seguro de eliminar esta temporada?')) return;

				try {
					const res = await fetch(`/api/temporadas/${id}`, { method: 'DELETE' });
					if (res.ok) {
						window.location.reload();
					} else {
						const data = await res.json();
						alert(data.error || 'Error al eliminar');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		});
	</script>
</AdminLayout>
