---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Nueva Temporada" activeRoute="temporadas" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/temporadas" class="back-link">← Volver a Temporadas</a>
		<div class="page-header">
			<h2>Nueva Temporada</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>

		<form class="form-card" id="temporada-form">
			<div class="form-group">
				<label for="nombre">Nombre de la Temporada *</label>
				<input type="text" id="nombre" name="nombre" placeholder="Ej: Temporada 2026" required />
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="fecha_inicio">Fecha Inicio *</label>
					<input type="date" id="fecha_inicio" name="fecha_inicio" required />
				</div>
				<div class="form-group">
					<label for="fecha_fin">Fecha Fin *</label>
					<input type="date" id="fecha_fin" name="fecha_fin" required />
				</div>
			</div>

			<div class="form-group">
				<label>
					<input type="checkbox" name="activa" value="true" style="width:auto;margin-right:0.4rem;" />
					Temporada activa
				</label>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Temporada</button>
				<a href="/admin/temporadas" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		document.getElementById('temporada-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');

			const data = {
				nombre: formData.get('nombre'),
				fecha_inicio: formData.get('fecha_inicio'),
				fecha_fin: formData.get('fecha_fin'),
				activa: formData.get('activa') === 'true',
			};

			try {
				const res = await fetch('/api/temporadas', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					window.location.href = '/admin/temporadas';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al crear temporada';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
