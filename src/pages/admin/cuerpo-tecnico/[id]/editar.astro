---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const [ctRes, equiposRes] = await Promise.all([
	supabase.from('cuerpo_tecnico').select('*, equipos(nombre)').eq('id', id).single(),
	supabase.from('equipos').select('id, nombre').order('nombre'),
]);

const ct = ctRes.data;
const equipos = equiposRes.data;

if (!ct) {
	return Astro.redirect('/admin/equipos');
}

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title={`Editar ${ct.nombre}`} activeRoute="equipos" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/equipos" class="back-link">← Volver a Equipos</a>
		<div class="page-header">
			<h2>Editar: {ct.nombre}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<form class="form-card" id="ct-form" data-id={id}>
			<div class="form-group">
				<label for="equipo_id">Equipo</label>
				<select id="equipo_id" name="equipo_id">
					{equipos?.map((eq) => (
						<option value={eq.id} selected={eq.id === ct.equipo_id}>{eq.nombre}</option>
					))}
				</select>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="nombre">Nombre</label>
					<input type="text" id="nombre" name="nombre" value={ct.nombre} required />
				</div>
				<div class="form-group">
					<label for="rol">Rol</label>
					<select id="rol" name="rol">
						<option value="DT" selected={ct.rol === 'DT'}>DT</option>
						<option value="Asistente" selected={ct.rol === 'Asistente'}>Asistente</option>
					</select>
				</div>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/equipos" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		const ctId = document.getElementById('ct-form').dataset.id;
		document.getElementById('ct-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const errorMsg = document.getElementById('error-msg');
			const successMsg = document.getElementById('success-msg');

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			const data = {
				equipo_id: parseInt(formData.get('equipo_id')),
				nombre: formData.get('nombre'),
				rol: formData.get('rol'),
			};

			try {
				const res = await fetch(`/api/cuerpo-tecnico/${ctId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Miembro actualizado correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
