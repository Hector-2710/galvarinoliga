---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { data: equipos } = await supabase
	.from('equipos')
	.select('*')
	.order('nombre');

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Equipos" activeRoute="equipos" {adminName}>
	<div class="page-header">
		<h2>Equipos</h2>
		<a href="/admin/equipos/nuevo" class="btn">+ Nuevo Equipo</a>
	</div>

	<div class="table-wrapper">
		<table>
			<thead>
				<tr>
					<th>Nombre</th>
					<th>Presidente</th>
					<th>Año</th>
					<th>Color</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody>
				{
					(equipos ?? []).length > 0 ? (
						(equipos ?? []).map((eq) => (
							<tr>
								<td style="font-weight:600;">{eq.nombre}</td>
								<td>{eq.presidente || '—'}</td>
								<td>{eq.ano_creacion || '—'}</td>
								<td>
									<span style="display:inline-block;width:18px;height:18px;border-radius:50%;background:{eq.color_principal || '#666'};vertical-align:middle;border:1px solid #ccc;"></span>
								</td>
								<td>
									<div style="display:flex;gap:0.4rem;">
										<a href={`/admin/equipos/${eq.id}/editar`} class="btn btn-sm">Editar</a>
										<button class="btn btn-sm btn-danger" data-delete-id={eq.id}>Eliminar</button>
									</div>
								</td>
							</tr>
						))
					) : (
						<tr>
							<td colspan="5">
								<div class="empty-state">No hay equipos registrados</div>
							</td>
						</tr>
					)
				}
			</tbody>
		</table>
	</div>

	<script>
		// @ts-nocheck
		document.querySelectorAll('[data-delete-id]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const id = btn.dataset.deleteId;
				if (!confirm('¿Estas seguro de eliminar este equipo? Se eliminaran tambien sus jugadores, cuerpo tecnico y titulos.')) return;

				try {
					const res = await fetch(`/api/equipos/${id}`, { method: 'DELETE' });
					if (res.ok) {
						window.location.reload();
					} else {
						const data = await res.json();
						alert(data.error || 'Error al eliminar');
					}
				} catch {
					alert('Error de conexion');
				}
			});
		});
	</script>
</AdminLayout>
