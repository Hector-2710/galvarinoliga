---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { createServerSupabase } from '../../../../lib/supabase';

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

const { data: equipo } = await supabase
	.from('equipos')
	.select('*')
	.eq('id', id)
	.single();

if (!equipo) {
	return Astro.redirect('/admin/equipos');
}

const [cuerpoTecnicoRes, titulosRes] = await Promise.all([
	supabase.from('cuerpo_tecnico').select('*').eq('equipo_id', id),
	supabase.from('titulos').select('*').eq('equipo_id', id).order('ano', { ascending: false }),
]);

const cuerpoTecnico = cuerpoTecnicoRes.data ?? [];
const titulos = titulosRes.data ?? [];

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title={`Editar ${equipo.nombre}`} activeRoute="equipos" {adminName}>
	<div style="max-width:800px;margin:0 auto;">
		<a href="/admin/equipos" class="back-link">← Volver a Equipos</a>
		<div class="page-header">
			<h2>Editar: {equipo.nombre}</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>
		<div class="success-msg" id="success-msg" style="display:none;"></div>

		<form class="form-card" id="equipo-form" data-id={id}>
			<h3 class="section-title">Informacion del Equipo</h3>

			<div class="form-group">
				<label for="nombre">Nombre del Equipo</label>
				<input type="text" id="nombre" name="nombre" value={equipo.nombre} required />
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="ano_creacion">Año de Creacion</label>
					<input type="number" id="ano_creacion" name="ano_creacion" min="1900" max="2030" value={equipo.ano_creacion ?? ''} />
				</div>
				<div class="form-group">
					<label for="color_principal">Color Principal</label>
					<input type="color" id="color_principal" name="color_principal" value={equipo.color_principal || '#E61E2A'} style="height:38px;padding:0.2rem;" />
				</div>
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="presidente">Presidente</label>
					<input type="text" id="presidente" name="presidente" value={equipo.presidente ?? ''} />
				</div>
				<div class="form-group">
					<label for="secretaria">Secretaria</label>
					<input type="text" id="secretaria" name="secretaria" value={equipo.secretaria ?? ''} />
				</div>
			</div>

			<div class="form-group">
				<label for="tesorera">Tesorera</label>
				<input type="text" id="tesorera" name="tesorera" value={equipo.tesorera ?? ''} />
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Cambios</button>
				<a href="/admin/equipos" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>

		<!-- Cuerpo Tecnico -->
		<div class="form-card sub-section">
			<h3 class="section-title">Cuerpo Tecnico</h3>
			<div id="cuerpo-tecnico-list" class="inline-list">
				{cuerpoTecnico.length > 0 ? cuerpoTecnico.map((ct) => (
					<div class="inline-item" data-ct-id={ct.id}>
						<div><strong>{ct.nombre}</strong> <small>({ct.rol})</small></div>
						<button class="btn btn-sm btn-danger" data-delete-ct={ct.id}>Eliminar</button>
					</div>
				)) : (
					<div style="color:#888;font-size:0.85rem;">Sin cuerpo tecnico registrado</div>
				)}
			</div>
			<div class="inline-add">
				<input type="text" id="ct-nombre" placeholder="Nombre" />
				<select id="ct-rol">
					<option value="DT">DT</option>
					<option value="Asistente">Asistente</option>
				</select>
				<button class="btn btn-sm" id="add-ct-btn">Agregar</button>
			</div>
		</div>

		<!-- Titulos -->
		<div class="form-card sub-section">
			<h3 class="section-title">Titulos</h3>
			<div id="titulos-list" class="inline-list">
				{titulos.length > 0 ? titulos.map((t) => (
					<div class="inline-item" data-titulo-id={t.id}>
						<div><strong>{t.nombre}</strong> <small>({t.ano})</small></div>
						<button class="btn btn-sm btn-danger" data-delete-titulo={t.id}>Eliminar</button>
					</div>
				)) : (
					<div style="color:#888;font-size:0.85rem;">Sin titulos registrados</div>
				)}
			</div>
			<div class="inline-add">
				<input type="text" id="titulo-nombre" placeholder="Nombre del titulo" style="flex:2;" />
				<input type="number" id="titulo-ano" placeholder="Año" min="1900" max="2030" style="flex:1;" />
				<button class="btn btn-sm" id="add-titulo-btn">Agregar</button>
			</div>
		</div>
	</div>

	<script>
		// @ts-nocheck
		const equipoId = document.getElementById('equipo-form').dataset.id;
		const errorMsg = document.getElementById('error-msg');
		const successMsg = document.getElementById('success-msg');

		document.getElementById('equipo-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);

			const data = {
				nombre: formData.get('nombre'),
				ano_creacion: formData.get('ano_creacion') ? parseInt(formData.get('ano_creacion')) : null,
				color_principal: formData.get('color_principal'),
				presidente: formData.get('presidente') || null,
				secretaria: formData.get('secretaria') || null,
				tesorera: formData.get('tesorera') || null,
			};

			errorMsg.style.display = 'none';
			successMsg.style.display = 'none';

			try {
				const res = await fetch(`/api/equipos/${equipoId}`, {
					method: 'PUT',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					successMsg.textContent = 'Equipo actualizado correctamente';
					successMsg.style.display = 'block';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al actualizar';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});

		document.getElementById('add-ct-btn')?.addEventListener('click', async () => {
			const nombre = document.getElementById('ct-nombre').value.trim();
			const rol = document.getElementById('ct-rol').value;
			if (!nombre) return alert('Ingrese un nombre');

			try {
				const res = await fetch('/api/cuerpo-tecnico', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ equipo_id: parseInt(equipoId), nombre, rol }),
				});

				if (res.ok) {
					window.location.reload();
				} else {
					const data = await res.json();
					alert(data.error || 'Error al agregar');
				}
			} catch {
				alert('Error de conexion');
			}
		});

		document.querySelectorAll('[data-delete-ct]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('¿Eliminar este miembro del cuerpo tecnico?')) return;
				try {
					const res = await fetch(`/api/cuerpo-tecnico/${btn.dataset.deleteCt}`, { method: 'DELETE' });
					if (res.ok) window.location.reload();
					else alert('Error al eliminar');
				} catch { alert('Error de conexion'); }
			});
		});

		document.getElementById('add-titulo-btn')?.addEventListener('click', async () => {
			const nombre = document.getElementById('titulo-nombre').value.trim();
			const ano = document.getElementById('titulo-ano').value;
			if (!nombre || !ano) return alert('Ingrese nombre y año del titulo');

			try {
				const res = await fetch('/api/titulos', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ equipo_id: parseInt(equipoId), nombre, ano: parseInt(ano) }),
				});

				if (res.ok) {
					window.location.reload();
				} else {
					const data = await res.json();
					alert(data.error || 'Error al agregar');
				}
			} catch {
				alert('Error de conexion');
			}
		});

		document.querySelectorAll('[data-delete-titulo]').forEach((btn) => {
			btn.addEventListener('click', async () => {
				if (!confirm('¿Eliminar este titulo?')) return;
				try {
					const res = await fetch(`/api/titulos/${btn.dataset.deleteTitulo}`, { method: 'DELETE' });
					if (res.ok) window.location.reload();
					else alert('Error al eliminar');
				} catch { alert('Error de conexion'); }
			});
		});
	</script>
</AdminLayout>
