---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';

const adminName = Astro.locals.user?.email ?? 'Admin';
---

<AdminLayout title="Nuevo Equipo" activeRoute="equipos" {adminName}>
	<div style="max-width:700px;margin:0 auto;">
		<a href="/admin/equipos" class="back-link">← Volver a Equipos</a>
		<div class="page-header">
			<h2>Nuevo Equipo</h2>
		</div>

		<div class="error-msg" id="error-msg" style="display:none;"></div>

		<form class="form-card" id="equipo-form">
			<div class="form-group">
				<label for="nombre">Nombre del Equipo *</label>
				<input type="text" id="nombre" name="nombre" placeholder="Ej: Galvarino FC" required />
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="ano_creacion">Año de Creacion</label>
					<input type="number" id="ano_creacion" name="ano_creacion" min="1900" max="2030" placeholder="Ej: 2010" />
				</div>

				<div class="form-group">
					<label for="color_principal">Color Principal</label>
					<input type="color" id="color_principal" name="color_principal" value="#E61E2A" style="height:38px;padding:0.2rem;" />
				</div>
			</div>

			<div class="form-group">
				<label for="presidente">Presidente</label>
				<input type="text" id="presidente" name="presidente" placeholder="Nombre del presidente" />
			</div>

			<div class="form-row">
				<div class="form-group">
					<label for="secretaria">Secretaria</label>
					<input type="text" id="secretaria" name="secretaria" placeholder="Nombre de la secretaria" />
				</div>

				<div class="form-group">
					<label for="tesorera">Tesorera</label>
					<input type="text" id="tesorera" name="tesorera" placeholder="Nombre de la tesorera" />
				</div>
			</div>

			<div class="form-actions">
				<button type="submit" class="btn">Guardar Equipo</button>
				<a href="/admin/equipos" class="btn btn-secondary">Cancelar</a>
			</div>
		</form>
	</div>

	<script>
		// @ts-nocheck
		document.getElementById('equipo-form')?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const form = e.target;
			const formData = new FormData(form);
			const errorMsg = document.getElementById('error-msg');

			const data = {
				nombre: formData.get('nombre'),
				ano_creacion: formData.get('ano_creacion') ? parseInt(formData.get('ano_creacion')) : null,
				color_principal: formData.get('color_principal'),
				presidente: formData.get('presidente') || null,
				secretaria: formData.get('secretaria') || null,
				tesorera: formData.get('tesorera') || null,
			};

			try {
				const res = await fetch('/api/equipos', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});

				if (res.ok) {
					window.location.href = '/admin/equipos';
				} else {
					const result = await res.json();
					errorMsg.textContent = result.error || 'Error al crear equipo';
					errorMsg.style.display = 'block';
				}
			} catch {
				errorMsg.textContent = 'Error de conexion';
				errorMsg.style.display = 'block';
			}
		});
	</script>
</AdminLayout>
