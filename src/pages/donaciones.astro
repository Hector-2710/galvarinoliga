---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SponsorsBanners from "../components/SponsorsBanners.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="donaciones">
			<div class="container">
				<h1 class="page-title fade-in-up">Sé parte del proyecto</h1>
				<p class="page-subtitle fade-in-up">
					¿Quieres ser parte de <strong>Galvarino Liga Fútbol</strong>? Ayúdanos con tu donación
					para seguir creciendo. Todo aporte es bienvenido.
				</p>

				<section class="seccion fade-in-up">
					<h2 class="section-title">¿Qué buscamos?</h2>
					<div class="content-card">
						<p>
							Crear una plataforma deportiva completa en Galvarino y poder expandirnos a más series,
							como femenino, sub 35 y sub 45.
						</p>
					</div>
				</section>

				<section class="seccion fade-in-up">
					<h2 class="section-title">¿Por qué donar?</h2>
					<div class="content-card">
						<p>
							Tu aporte ayuda a fomentar el deporte local, llegar a más gente de la comuna y
							reinvertir cada peso en la plataforma y su mejora continua. No hay un monto mínimo:
							todo aporte es bienvenido.
						</p>
					</div>
				</section>

				<div class="donaciones-contacto fade-in-up">
					<h2 class="section-title">¿Quieres cooperar?</h2>
					<p class="contacto-desc">
						Si quieres cooperar, comunícate con el correo de la cuenta. Te contamos cómo hacer
						tu donación y cómo puedes sumarte al proyecto.
					</p>
					<div class="contacto-links">
						<a href="mailto:galvarinoligafutbol@gmail.com?subject=Quiero%20cooperar" class="contacto-link">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
							galvarinoligafutbol@gmail.com
						</a>
						<a href="https://www.instagram.com/galvarinoliga/" class="contacto-link" target="_blank" rel="noopener noreferrer">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
							@galvarinoliga
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	.donaciones {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-xl);
		line-height: 1.7;
	}

	.page-subtitle strong {
		color: var(--color-neutral);
	}

	.section-title {
		font-family: var(--font-headline);
		font-size: 1.3rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-md);
		position: relative;
		display: inline-block;
	}

	.section-title::after {
		content: '';
		display: block;
		width: 100%;
		height: 3px;
		background: var(--color-primary);
		margin-top: 4px;
		border-radius: 2px;
	}

	.seccion {
		margin-bottom: var(--spacing-2xl);
	}

	.content-card {
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: var(--border-radius-lg);
		padding: var(--spacing-lg);
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		line-height: 1.7;
	}

	.donaciones-contacto {
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: var(--border-radius-lg);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.contacto-desc {
		font-family: var(--font-body);
		font-size: 0.85rem;
		color: var(--color-secondary);
		line-height: 1.6;
		margin-bottom: var(--spacing-lg);
	}

	.contacto-links {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.contacto-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-md);
		color: var(--color-neutral);
		text-decoration: none;
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 500;
		padding: var(--spacing-md) var(--spacing-lg);
		background: linear-gradient(145deg, rgba(230, 30, 42, 0.08), rgba(230, 30, 42, 0.02));
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--border-radius-md);
		transition: all 0.25s;
		position: relative;
		overflow: hidden;
	}

	.contacto-link::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 3px;
		height: 100%;
		background: var(--color-primary);
		border-radius: 0 2px 2px 0;
	}

	.contacto-link svg {
		flex-shrink: 0;
		width: 22px;
		height: 22px;
		color: var(--color-primary-light);
	}

	.contacto-link:hover {
		color: var(--color-neutral);
		background: linear-gradient(145deg, rgba(230, 30, 42, 0.18), rgba(230, 30, 42, 0.06));
		border-color: rgba(230, 30, 42, 0.35);
		transform: translateY(-2px);
	}

	@media (min-width: 640px) {
		.donaciones {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}

		.section-title {
			font-size: 1.5rem;
		}

		.content-card {
			padding: var(--spacing-xl);
			font-size: 0.95rem;
		}

		.contacto-links {
			flex-direction: row;
		}

		.contacto-link {
			flex: 1;
		}

		.donaciones-contacto {
			padding: var(--spacing-xl);
		}
	}

	@media (min-width: 1024px) {
		.donaciones {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-2xl);
		}

		.section-title {
			font-size: 1.7rem;
		}

		.content-card {
			padding: var(--spacing-2xl);
			font-size: 1rem;
			border-radius: var(--border-radius-xl);
		}

		.donaciones-contacto {
			padding: var(--spacing-2xl);
			border-radius: var(--border-radius-xl);
		}

		.contacto-desc {
			font-size: 0.95rem;
		}

		.contacto-link {
			font-size: 0.95rem;
		}
	}

	@media (min-width: 1280px) {
		.page-title {
			font-size: 3.2rem;
		}

		.section-title {
			font-size: 1.9rem;
		}
	}
</style>
