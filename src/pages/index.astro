---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Banner from "../components/Banner.astro";
import NextMatches from "../components/NextMatches.astro";
import StandingsTable from "../components/StandingsTable.astro";
import Footer from "../components/Footer.astro";
import { calcularTabla, getProximosPartidosDeFecha } from "../lib/liga";

const partidos = await getProximosPartidosDeFecha();

const standings = (await calcularTabla()).map((fila) => ({
	pos: fila.pos,
	equipo_nombre: fila.equipo.nombre,
	logo: fila.equipo.logo,
	pj: fila.pj,
	g: fila.g,
	e: fila.e,
	p: fila.p,
	gf: fila.gf,
	gc: fila.gc,
	dg: fila.dg,
	pts: fila.pts,
}));
---

<Layout>
	<Header />
	<main class="main-content">
		<NextMatches partidos={partidos} />

		<div class="separador" aria-hidden="true"><span></span><i></i><span></span></div>

		<StandingsTable teams={standings} />

		<div class="container">
			<Banner />
		</div>
	</main>
	<Footer />
</Layout>

<style is:global>
	.separador {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		margin: 0 var(--spacing-md);
	}

	.separador > span {
		flex: 1;
		height: 1px;
		background: var(--color-line);
	}

	.separador i {
		position: relative;
		width: 12px;
		height: 12px;
		flex-shrink: 0;
		border: 1px solid var(--color-secondary);
		border-radius: 50%;
		opacity: 0.7;
	}

	.separador i::after {
		content: '';
		position: absolute;
		inset: 3px;
		border-radius: 50%;
		background: var(--color-primary);
	}

	@media (min-width: 1024px) {
		.separador {
			margin: 0 var(--spacing-xl);
		}
	}
</style>
