---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SponsorsBanners from "../../components/SponsorsBanners.astro";
import Footer from "../../components/Footer.astro";
import { createServerSupabase } from "../../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
	return Astro.redirect("/fixture");
}

// Fetch match with team names + logos
const { data: match, error: matchError } = await supabase
	.from("partidos")
	.select(`
		*,
		equipo1:equipo1_id(id, nombre, logo_url, color_principal),
		equipo2:equipo2_id(id, nombre, logo_url, color_principal),
		jornada:jornada_id(numero, nombre)
	`)
	.eq("id", id)
	.single();

if (matchError || !match) {
	return Astro.redirect("/fixture");
}

// Fetch goals with player names + jersey numbers
const { data: golesData } = await supabase
	.from("goles")
	.select(`
		id,
		partido_id,
		jugador_id,
		equipo_id,
		jugador:jugador_id(nombre, apellido, numero_camiseta)
	`)
	.eq("partido_id", Number(id))
	.order("id");

// --- Interfaces ---
interface EquipoRef {
	id: number;
	nombre: string;
	logo_url: string | null;
	color_principal: string | null;
}

interface JugadorRef {
	nombre: string;
	apellido: string;
	numero_camiseta: number | null;
}

interface GolData {
	id: number;
	equipo_id: number | null;
	jugador: JugadorRef | JugadorRef[] | null;
}

interface JornadaRef {
	numero: number;
	nombre: string;
}

// --- Normalize helpers ---
function normalizeEquipo(
	eq: EquipoRef | EquipoRef[] | null,
): EquipoRef | null {
	if (!eq) return null;
	if (Array.isArray(eq)) return eq[0] ?? null;
	return eq;
}

function normalizeJugador(
	j: JugadorRef | JugadorRef[] | null,
): JugadorRef | null {
	if (!j) return null;
	if (Array.isArray(j)) return j[0] ?? null;
	return j;
}

function normalizeJornada(
	j: JornadaRef | JornadaRef[] | null,
): JornadaRef | null {
	if (!j) return null;
	if (Array.isArray(j)) return j[0] ?? null;
	return j;
}

const equipo1 = normalizeEquipo(match.equipo1 as EquipoRef | EquipoRef[] | null);
const equipo2 = normalizeEquipo(match.equipo2 as EquipoRef | EquipoRef[] | null);
const jornada = normalizeJornada(match.jornada as JornadaRef | JornadaRef[] | null);

// Group goals by team
const goles: GolData[] = (golesData ?? []) as GolData[];
const golesEquipo1 = goles.filter((g) => g.equipo_id === equipo1?.id);
const golesEquipo2 = goles.filter((g) => g.equipo_id === equipo2?.id);

// --- Formatting ---
function formatFecha(fechaStr: string): string {
	const fecha = new Date(fechaStr + "T12:00:00");
	const dias = ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];
	const meses = [
		"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
		"Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
	];
	return `${dias[fecha.getDay()]} ${fecha.getDate()} de ${meses[fecha.getMonth()]}`;
}

function formatHora(hora: string | null): string {
	if (!hora) return "";
	return hora.slice(0, 5);
}

function estadoLabel(estado: string): string {
	switch (estado) {
		case "programado": return "Programado";
		case "en_vivo": return "En Vivo";
		case "finalizado": return "Finalizado";
		default: return estado;
	}
}

function jugadorNombre(j: JugadorRef | null): string {
	if (!j) return "Desconocido";
	return `${j.nombre} ${j.apellido}`;
}

const goles1 = match.goles1 as number | null;
const goles2 = match.goles2 as number | null;
const estado = match.estado as string;
const isGanador1 = estado === "finalizado" && goles1 !== null && goles2 !== null && goles1 > goles2;
const isGanador2 = estado === "finalizado" && goles1 !== null && goles2 !== null && goles2 > goles1;
const color1 = equipo1?.color_principal ?? "#E61E2A";
const color2 = equipo2?.color_principal ?? "#E61E2A";
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="match-detail">
			<div class="container">
				<a href="/fixture" class="back-link fade-in-up">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					Volver al Fixture
				</a>

				{/* --- Match Header: Teams + Score --- */}
				<div class:list={{
					"match-header": true,
					"match-header--envivo": estado === "en_vivo",
					"match-header--finalizado": estado === "finalizado",
				}}>
					{jornada && (
						<div class="match-header__jornada">
							<span class="match-header__jornada-badge">{jornada.numero}</span>
							<span class="match-header__jornada-name">{jornada.nombre}</span>
						</div>
					)}

					<div class="match-header__teams">
						{/* Team 1 (Home) */}
						<div class:list={{ "match-header__team": true, "match-header__team--winner": isGanador1 }}>
							<div class="match-header__team-logo-wrap" style={`background-color: ${color1}`}>
								{equipo1?.logo_url ? (
									<img src={equipo1.logo_url} alt={equipo1.nombre} class="match-header__team-logo" />
								) : (
									<span class="match-header__team-initial">{equipo1?.nombre?.charAt(0) ?? "?"}</span>
								)}
							</div>
							<span class="match-header__team-name">{equipo1?.nombre ?? "—"}</span>
							<span class="match-header__team-role">Local</span>
						</div>

						{/* Score / VS */}
						<div class="match-header__score-box">
							{estado === "finalizado" ? (
								<div class="match-header__score">
									<span class:list={{ "match-header__goal-num": true, "match-header__goal-num--winner": isGanador1 }}>
										{goles1 ?? 0}
									</span>
									<span class="match-header__score-sep">-</span>
									<span class:list={{ "match-header__goal-num": true, "match-header__goal-num--winner": isGanador2 }}>
										{goles2 ?? 0}
									</span>
								</div>
							) : estado === "en_vivo" ? (
								<div class="match-header__score match-header__score--envivo">
									{goles1 ?? "?"}
									<span class="match-header__score-sep">-</span>
									{goles2 ?? "?"}
								</div>
							) : (
								<div class="match-header__vs">
									<span class="match-header__vs-text">VS</span>
								</div>
							)}
						</div>

						{/* Team 2 (Away) */}
						<div class:list={{ "match-header__team": true, "match-header__team--winner": isGanador2 }}>
							<div class="match-header__team-logo-wrap" style={`background-color: ${color2}`}>
								{equipo2?.logo_url ? (
									<img src={equipo2.logo_url} alt={equipo2.nombre} class="match-header__team-logo" />
								) : (
									<span class="match-header__team-initial">{equipo2?.nombre?.charAt(0) ?? "?"}</span>
								)}
							</div>
							<span class="match-header__team-name">{equipo2?.nombre ?? "—"}</span>
							<span class="match-header__team-role">Visita</span>
						</div>
					</div>

					{/* Estado badge */}
					<div class="match-header__estado-row">
						<span class:list={{
							"match-header__estado": true,
							"match-header__estado--envivo": estado === "en_vivo",
							"match-header__estado--finalizado": estado === "finalizado",
							"match-header__estado--programado": estado === "programado",
						}}>
							{estado === "en_vivo" && <span class="live-dot"></span>}
							{estadoLabel(estado)}
						</span>
					</div>
				</div>

				{/* --- Match Info --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title">Información del Partido</h2>
					<div class="info-grid">
						<div class="info-item">
							<span class="info-item__label">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
									<line x1="16" y1="2" x2="16" y2="6"></line>
									<line x1="8" y1="2" x2="8" y2="6"></line>
									<line x1="3" y1="10" x2="21" y2="10"></line>
								</svg>
								Fecha
							</span>
							<span class="info-item__value">{formatFecha(match.fecha)}</span>
						</div>
						{match.hora && (
							<div class="info-item">
								<span class="info-item__label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<polyline points="12 6 12 12 16 14"></polyline>
									</svg>
									Hora
								</span>
								<span class="info-item__value">{formatHora(match.hora)}</span>
							</div>
						)}
						<div class="info-item">
							<span class="info-item__label">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
									<circle cx="12" cy="10" r="3"></circle>
								</svg>
								Cancha
							</span>
							<span class="info-item__value">{match.cancha}</span>
						</div>
						{jornada && (
							<div class="info-item">
								<span class="info-item__label">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle>
										<line x1="12" y1="8" x2="12" y2="16"></line>
										<line x1="8" y1="12" x2="16" y2="12"></line>
									</svg>
									Jornada
								</span>
								<span class="info-item__value">{jornada.nombre}</span>
							</div>
						)}
					</div>
				</div>

				{/* --- Scorers: Equipo 1 --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title" style={`border-bottom-color: ${color1}`}>
						Goles — {equipo1?.nombre ?? "Equipo 1"}
					</h2>
					{golesEquipo1.length === 0 ? (
						<p class="empty-text">Sin goles registrados</p>
					) : (
						<div class="scorers-list">
							{golesEquipo1.map((gol) => {
								const jugador = normalizeJugador(gol.jugador as JugadorRef | JugadorRef[] | null);
								return (
									<div class="scorer-row">
										<div class="scorer-row__icon">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<circle cx="12" cy="12" r="10"></circle>
												<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
												<line x1="2" y1="12" x2="22" y2="12"></line>
											</svg>
										</div>
										<div class="scorer-row__info">
											<span class="scorer-row__name">{jugadorNombre(jugador)}</span>
											{jugador?.numero_camiseta && (
												<span class="scorer-row__number">#{jugador.numero_camiseta}</span>
											)}
										</div>
										<span class="scorer-row__goal-badge">⚽</span>
									</div>
								);
							})}
						</div>
					)}
				</div>

				{/* --- Scorers: Equipo 2 --- */}
				<div class="section-card fade-in-up">
					<h2 class="section-card__title" style={`border-bottom-color: ${color2}`}>
						Goles — {equipo2?.nombre ?? "Equipo 2"}
					</h2>
					{golesEquipo2.length === 0 ? (
						<p class="empty-text">Sin goles registrados</p>
					) : (
						<div class="scorers-list">
							{golesEquipo2.map((gol) => {
								const jugador = normalizeJugador(gol.jugador as JugadorRef | JugadorRef[] | null);
								return (
									<div class="scorer-row">
										<div class="scorer-row__icon">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<circle cx="12" cy="12" r="10"></circle>
												<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
												<line x1="2" y1="12" x2="22" y2="12"></line>
											</svg>
										</div>
										<div class="scorer-row__info">
											<span class="scorer-row__name">{jugadorNombre(jugador)}</span>
											{jugador?.numero_camiseta && (
												<span class="scorer-row__number">#{jugador.numero_camiseta}</span>
											)}
										</div>
										<span class="scorer-row__goal-badge">⚽</span>
									</div>
								);
							})}
						</div>
					)}
				</div>
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	/* ================================================
	   Base (Mobile First) — < 640px
	   ================================================ */
	.match-detail {
		padding: var(--spacing-lg) 0;
	}

	/* ---- Back Link ---- */
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		font-family: var(--font-label);
		font-size: 0.8rem;
		color: var(--color-secondary);
		text-decoration: none;
		margin-bottom: var(--spacing-lg);
		transition: color 0.2s ease, gap 0.2s ease;
		padding: var(--spacing-sm) 0;
		min-height: 44px;
		-webkit-tap-highlight-color: transparent;
		border-radius: var(--border-radius-sm);
	}

	.back-link svg {
		flex-shrink: 0;
		transition: transform 0.2s ease;
	}

	@media (hover: hover) {
		.back-link:hover {
			color: var(--color-neutral);
			gap: var(--spacing-sm);
		}

		.back-link:hover svg {
			transform: translateX(-3px);
		}
	}

	.back-link:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	/* ---- Match Header Card ---- */
	.match-header {
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
		text-align: center;
	}

	.match-header--envivo {
		border-left: 4px solid var(--color-primary-light);
		animation: pulse-border 2s ease-in-out infinite;
	}

	.match-header--finalizado {
		border-left: 4px solid #22c55e;
	}

	@keyframes pulse-border {
		0%, 100% { border-left-color: var(--color-primary-light); }
		50% { border-left-color: rgba(255, 58, 69, 0.4); }
	}

	/* Jornada badge */
	.match-header__jornada {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-lg);
	}

	.match-header__jornada-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-neutral);
		font-family: var(--font-label);
		font-size: 0.8rem;
		font-weight: 700;
		box-shadow: var(--shadow-red);
	}

	.match-header__jornada-name {
		font-family: var(--font-headline);
		font-size: 0.85rem;
		text-transform: uppercase;
		color: var(--color-secondary);
		letter-spacing: 0.02em;
	}

	/* Teams row */
	.match-header__teams {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--spacing-md);
		margin-bottom: var(--spacing-md);
	}

	.match-header__team {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-sm);
		flex: 1;
		min-width: 0;
	}

	.match-header__team--winner .match-header__team-name {
		color: #4ade80;
	}

	.match-header__team-logo-wrap {
		width: 64px;
		height: 64px;
		border-radius: var(--border-radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.match-header__team-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 6px;
	}

	.match-header__team-initial {
		font-family: var(--font-headline);
		font-size: 1.8rem;
		color: var(--color-neutral);
		text-transform: uppercase;
	}

	.match-header__team-name {
		font-family: var(--font-headline);
		font-size: 0.9rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
		text-align: center;
	}

	.match-header__team-role {
		font-family: var(--font-label);
		font-size: 0.6rem;
		text-transform: uppercase;
		color: var(--color-secondary);
		letter-spacing: 0.08em;
		opacity: 0.7;
	}

	/* Score box */
	.match-header__score-box {
		flex-shrink: 0;
	}

	.match-header__score {
		display: flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-headline);
		font-size: 2rem;
		color: var(--color-neutral);
		min-width: 80px;
		justify-content: center;
	}

	.match-header__score--envivo {
		color: var(--color-primary-light);
	}

	.match-header__score-sep {
		color: var(--color-secondary);
		font-size: 1.2rem;
	}

	.match-header__goal-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 30px;
	}

	.match-header__goal-num--winner {
		color: #4ade80;
		font-weight: 700;
	}

	/* VS badge */
	.match-header__vs {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-primary);
		border-radius: 50%;
		box-shadow: var(--shadow-red);
	}

	.match-header__vs-text {
		font-family: var(--font-headline);
		font-size: 1rem;
		color: var(--color-neutral);
		letter-spacing: 0.04em;
	}

	/* Estado badge */
	.match-header__estado-row {
		display: flex;
		justify-content: center;
	}

	.match-header__estado {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-label);
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 4px 14px;
		border-radius: 20px;
		background: rgba(168, 173, 179, 0.15);
		color: var(--color-secondary);
	}

	.match-header__estado--envivo {
		background: rgba(230, 30, 42, 0.15);
		color: var(--color-primary-light);
	}

	.match-header__estado--finalizado {
		background: rgba(34, 197, 94, 0.12);
		color: #4ade80;
	}

	.match-header__estado--programado {
		background: rgba(168, 173, 179, 0.1);
		color: var(--color-secondary);
	}

	.live-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--color-primary-light);
		animation: pulse 1s ease-in-out infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; }
		50% { opacity: 0.4; }
	}

	/* ---- Section Card ---- */
	.section-card {
		background: linear-gradient(145deg, var(--color-tertiary-light) 0%, var(--color-tertiary) 100%);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.section-card__title {
		font-family: var(--font-headline);
		font-size: 1.05rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-md);
		padding-bottom: var(--spacing-sm);
		border-bottom: 2px solid var(--color-primary);
	}

	/* ---- Info Grid ---- */
	.info-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-md);
	}

	.info-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.info-item__label {
		display: flex;
		align-items: center;
