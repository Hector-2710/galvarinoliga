---
import { getGolesDePartido, getPartido, getPartidos } from "../../lib/liga";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import MatchRow from "../../components/MatchRow.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
	const partidos = await getPartidos();
	return partidos.map((partido) => ({ params: { slug: partido.slug } }));
}

const partido = await getPartido(Astro.params.slug ?? "");

if (!partido) {
	throw new Error(`El partido "${Astro.params.slug}" no existe`);
}

const equipo1 = partido.equipo1;
const equipo2 = partido.equipo2;
const jornada = partido.jornada;

const goles = await getGolesDePartido(partido.slug);
const golesEquipo1 = goles
	.filter((gol) => gol.equipo.slug === equipo1.slug)
	.map((gol) => gol.jugador);
const golesEquipo2 = goles
	.filter((gol) => gol.equipo.slug === equipo2.slug)
	.map((gol) => gol.jugador);

const fecha = new Intl.DateTimeFormat('es-CL', {
	weekday: 'long',
	day: 'numeric',
	month: 'long',
	year: 'numeric',
}).format(new Date(`${partido.fecha}T12:00:00`));
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="partido">
			<div class="container">
				<a href="/fixture" class="volver">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					Volver a Jornadas
				</a>

				<p class="partido__jornada">
					<a href="/fixture">Jornada {jornada.numero}</a>
					<span>{fecha}</span>
				</p>

				<MatchRow partido={partido} destacado />

				<div class="bloque">
					<h2 class="bloque__titulo">Información del partido</h2>
					<dl class="datos">
						<div>
							<dt>Hora</dt>
							<dd>{partido.hora.slice(0, 5)}</dd>
						</div>
						<div>
							<dt>Cancha</dt>
							<dd>{partido.cancha}</dd>
						</div>
					</dl>
				</div>

				<div class="bloque">
					<h2 class="bloque__titulo">Goles de {equipo1.nombre}</h2>
					{
						golesEquipo1.length === 0 ? (
							<p class="vacio">Sin goles registrados.</p>
						) : (
							<ul class="goleadores">
								{golesEquipo1.map((jugador) => (
									<li><span>{jugador}</span><span>1</span></li>
								))}
							</ul>
						)
					}
				</div>

				<div class="bloque">
					<h2 class="bloque__titulo">Goles de {equipo2.nombre}</h2>
					{
						golesEquipo2.length === 0 ? (
							<p class="vacio">Sin goles registrados.</p>
						) : (
							<ul class="goleadores">
								{golesEquipo2.map((jugador) => (
									<li><span>{jugador}</span><span>1</span></li>
								))}
							</ul>
						)
					}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.partido {
		padding: var(--spacing-xl) 0 var(--spacing-2xl);
	}

	.volver {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		min-height: 44px;
		font-family: var(--font-body);
		font-size: 0.85rem;
		color: var(--color-secondary);
		text-decoration: none;
	}

	.volver:hover {
		color: var(--color-neutral);
	}

	.partido__jornada {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-xs) var(--spacing-md);
		margin-top: var(--spacing-lg);
		font-family: var(--font-body);
		font-size: 0.8rem;
		color: var(--color-secondary);
	}

	.partido__jornada a {
		color: var(--color-neutral);
		border-bottom: 1px solid var(--color-primary);
	}

	.bloque {
		padding: var(--spacing-lg) 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.bloque__titulo {
		margin-bottom: var(--spacing-md);
		font-family: var(--font-headline);
		font-size: 1.15rem;
		font-weight: 400;
		text-transform: uppercase;
		color: var(--color-neutral);
	}

	.datos {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-md);
	}

	.datos dt,
	.goleadores {
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-secondary);
	}

	.datos dd {
		margin-top: 2px;
		font-size: 1rem;
		color: var(--color-neutral);
	}

	.goleadores {
		list-style: none;
	}

	.goleadores li {
		display: flex;
		justify-content: space-between;
		gap: var(--spacing-md);
		padding: var(--spacing-sm) 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
		font-size: 0.95rem;
		color: var(--color-neutral);
	}

	.goleadores li span:last-child {
		font-variant-numeric: tabular-nums;
		color: var(--color-secondary);
	}

	.vacio {
		font-size: 0.9rem;
		color: var(--color-secondary);
	}

	@media (min-width: 640px) {
		.datos {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 1024px) {
		.partido {
			padding: var(--spacing-2xl) 0;
		}

		.bloque__titulo {
			font-size: 1.4rem;
		}
	}
</style>
