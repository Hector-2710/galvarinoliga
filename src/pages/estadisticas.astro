---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import SponsorsBanners from "../components/SponsorsBanners.astro";
import Footer from "../components/Footer.astro";
import { getGoleadores } from "../lib/liga";

const topGoleadores = await getGoleadores();

function medalla(pos: number): string {
	if (pos === 0) return "🥇";
	if (pos === 1) return "🥈";
	if (pos === 2) return "🥉";
	return "";
}
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="estadisticas">
			<div class="container">
				<h1 class="page-title fade-in-up">Estadísticas</h1>
				<p class="page-subtitle fade-in-up">
					Máximos goleadores de la temporada
				</p>

				<div class="stats-card fade-in-up">
					<h2 class="stats-card__title">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<path d="M12 6v6l4 2"></path>
						</svg>
						Goleadores
					</h2>

					{topGoleadores.length === 0 ? (
						<div class="empty-state">
							<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<path d="M16.24 7.76a6 6 0 0 1 0 8.49"></path>
								<path d="M7.76 7.76a6 6 0 0 0 0 8.49"></path>
							</svg>
							<p>No hay goles registrados todavía.</p>
						</div>
					) : (
						<div class="stats-table-wrapper">
							<table class="stats-table">
								<thead>
									<tr>
										<th class="stats-table__th stats-table__th--pos">#</th>
										<th class="stats-table__th stats-table__th--player">Jugador</th>
										<th class="stats-table__th stats-table__th--team">Equipo</th>
										<th class="stats-table__th stats-table__th--stat">Goles</th>
									</tr>
								</thead>
								<tbody>
									{topGoleadores.map((g, i) => (
										<tr class="stats-table__row">
											<td class="stats-table__td stats-table__td--pos">
												<span class:list={{
													"stats-table__pos-badge": true,
													"stats-table__pos-badge--medal": i < 3,
												}}>
													{i < 3 ? medalla(i) : i + 1}
												</span>
											</td>
											<td class="stats-table__td stats-table__td--player">
												<span class="stats-table__player-name">{g.jugador}</span>
											</td>
											<td class="stats-table__td stats-table__td--team">
												<span class="stats-table__team-name">{g.equipo.nombre}</span>
											</td>
											<td class="stats-table__td stats-table__td--stat">
												<span class="stats-table__stat-badge stats-table__stat-badge--goles">
													{g.goles} {g.goles === 1 ? "gol" : "goles"}
												</span>
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
				</div>

			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	.estadisticas {
		padding: var(--spacing-lg) 0;
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: 2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xs);
	}

	.page-subtitle {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		margin-bottom: var(--spacing-xl);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-2xl) 0;
		color: var(--color-secondary);
		text-align: center;
	}

	.empty-state svg {
		opacity: 0.4;
	}

	.empty-state p {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-style: italic;
	}

	.stats-card {
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
		transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
	}

	.stats-card:active {
		transform: scale(0.99);
	}

	.stats-card__title {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-headline);
		font-size: 1.2rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-md);
		padding-bottom: var(--spacing-sm);
		border-bottom: 2px solid var(--color-primary);
	}

	.stats-card__title svg {
		flex-shrink: 0;
		opacity: 0.8;
	}

	.stats-table-wrapper {
		overflow-x: auto;
		margin: 0 calc(-1 * var(--spacing-lg));
		padding: 0 var(--spacing-lg);
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
	}

	.stats-table {
		width: 100%;
		min-width: 420px;
		border-collapse: separate;
		border-spacing: 0 4px;
	}

	.stats-table__th {
		font-family: var(--font-label);
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		color: var(--color-neutral);
		padding: var(--spacing-sm) var(--spacing-xs);
		text-align: center;
		letter-spacing: 0.06em;
		white-space: nowrap;
		background: var(--color-primary);
	}

	.stats-table__th:first-child {
		border-radius: var(--border-radius-sm) 0 0 var(--border-radius-sm);
		padding-left: var(--spacing-sm);
	}

	.stats-table__th:last-child {
		border-radius: 0 var(--border-radius-sm) var(--border-radius-sm) 0;
		padding-right: var(--spacing-sm);
	}

	.stats-table__th--pos {
		text-align: center;
		width: 44px;
	}

	.stats-table__th--player {
		text-align: left;
	}

	.stats-table__th--team {
		text-align: left;
	}

	.stats-table__th--stat {
		text-align: center;
		width: 100px;
	}

	.stats-table__row {
		transition: background 0.2s;
		border-radius: var(--border-radius-sm);
	}

	.stats-table__row:hover {
		background: rgba(255, 255, 255, 0.04);
	}

	.stats-table__td {
		font-family: var(--font-label);
		font-size: 0.75rem;
		color: var(--color-secondary);
		padding: var(--spacing-sm) var(--spacing-xs);
		text-align: center;
		white-space: nowrap;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
	}

	.stats-table__td--pos {
		text-align: center;
		padding-left: var(--spacing-sm);
	}

	.stats-table__td--player {
		text-align: left;
	}

	.stats-table__td--team {
		text-align: left;
	}

	.stats-table__td--stat {
		text-align: center;
	}

	.stats-table__pos-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.06);
		font-family: var(--font-label);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-secondary);
	}

	.stats-table__pos-badge--medal {
		background: transparent;
		font-size: 1.1rem;
	}

	.stats-table__player-name {
		font-family: var(--font-body);
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--color-neutral);
		text-decoration: none;
		transition: color 0.2s;
	}

	@media (hover: hover) {
		.stats-table__player-name:hover {
			color: var(--color-primary-light);
			text-decoration: underline;
		}
	}

	.stats-table__team-name {
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.stats-table__stat-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 32px;
		padding: 2px 10px;
		border-radius: 20px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		font-weight: 700;
	}

	.stats-table__stat-badge--goles {
		background: rgba(34, 197, 94, 0.15);
		color: #4ade80;
	}

	.stats-table__stat-badge--total {
		background: rgba(168, 173, 179, 0.15);
		color: var(--color-secondary-light);
	}

	@media (min-width: 640px) {
		.estadisticas {
			padding: var(--spacing-xl) 0;
		}

		.page-title {
			font-size: 2.4rem;
		}

		.stats-card {
			padding: var(--spacing-xl);
		}

		.stats-card__title {
			font-size: 1.3rem;
		}

		.stats-table__th {
			font-size: 0.7rem;
			padding: var(--spacing-md) var(--spacing-sm);
		}

		.stats-table__th:first-child {
			padding-left: var(--spacing-md);
		}

		.stats-table__th:last-child {
			padding-right: var(--spacing-md);
		}

		.stats-table__td {
			font-size: 0.8rem;
			padding: var(--spacing-md) var(--spacing-sm);
		}

		.stats-table__td--pos {
			padding-left: var(--spacing-md);
		}

		.stats-table__player-name {
			font-size: 0.9rem;
		}

		.stats-table__team-name {
			font-size: 0.75rem;
		}

		.stats-table__stat-badge {
			font-size: 0.75rem;
			padding: 3px 12px;
		}

		.stats-table__pos-badge {
			width: 32px;
			height: 32px;
			font-size: 0.8rem;
		}

		.stats-table__pos-badge--medal {
			font-size: 1.2rem;
		}
	}

	@media (min-width: 1024px) {
		.estadisticas {
			padding: var(--spacing-2xl) 0;
		}

		.page-title {
			font-size: 2.8rem;
		}

		.page-subtitle {
			font-size: 1rem;
			margin-bottom: var(--spacing-2xl);
		}

		.stats-card {
			padding: var(--spacing-xl);
			margin-bottom: var(--spacing-xl);
			transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
		}

		.stats-card:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow-lg);
			border-color: rgba(230, 30, 42, 0.3);
		}

		.stats-card:active {
			transform: scale(0.98);
		}

		.stats-card__title {
			font-size: 1.4rem;
			margin-bottom: var(--spacing-lg);
		}

		.stats-table__th {
			font-size: 0.75rem;
		}

		.stats-table__td {
			font-size: 0.85rem;
		}

		.stats-table__player-name {
			font-size: 0.95rem;
		}

		.stats-table__stat-badge {
			font-size: 0.8rem;
		}

		.stats-table__table {
			border-spacing: 0 6px;
		}
	}

	@media (min-width: 1280px) {
		.page-title {
			font-size: 3.2rem;
		}

		.stats-card__title {
			font-size: 1.5rem;
		}

		.stats-table__player-name {
			font-size: 1rem;
		}
	}
</style>
