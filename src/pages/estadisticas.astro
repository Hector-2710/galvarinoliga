---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getGoleadores } from "../lib/liga";

const goleadores = await getGoleadores();
const hayMasGoleadores = goleadores.length > 5;
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="estadisticas">
			<div class="container">
				<h1 class="page-title">Goleadores</h1>
				<p class="page-subtitle">Goles de la temporada</p>

				{
					goleadores.length === 0 ? (
						<p class="vacio">Todavía no hay goles registrados.</p>
					) : (
						<>
							<div class="ranking">
								<div class="ranking__cabecera" aria-hidden="true">
									<span>#</span>
									<span>Jugador</span>
									<span>Equipo</span>
									<span>Goles</span>
								</div>
								<ol id="goleadores-lista">
									{goleadores.map((goleador, i) => (
										<li class:list={['ranking__fila', { 'ranking__fila--extra': i >= 5 }]}>
											<span class="ranking__pos">{i + 1}</span>
											<span class="ranking__jugador">
												{goleador.jugador}
												<small>{goleador.equipo.nombre}</small>
											</span>
											<span class="ranking__equipo">
												<i style={`--club: ${goleador.equipo.color_principal}`} aria-hidden="true"></i>
												{goleador.equipo.nombre}
											</span>
											<span class:list={['ranking__goles', { 'ranking__goles--lider': i === 0 }]}>
												{goleador.goles}
											</span>
										</li>
									))}
								</ol>
							</div>

							{hayMasGoleadores && (
								<button type="button" class="ver-todos" id="goleadores-toggle" aria-expanded="false" aria-controls="goleadores-lista">
									Ver todos los goleadores
								</button>
							)}
						</>
					)
				}
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.estadisticas {
		padding: var(--spacing-xl) 0 var(--spacing-2xl);
	}

	.page-title {
		font-family: var(--font-headline);
		font-size: clamp(2.5rem, 10vw, 3.2rem);
		font-weight: 400;
		line-height: 1;
		text-transform: uppercase;
		color: var(--color-neutral);
	}

	.page-subtitle {
		margin: var(--spacing-sm) 0 var(--spacing-2xl);
		font-family: var(--font-body);
		font-size: 0.95rem;
		color: var(--color-secondary);
	}

	.vacio {
		padding: var(--spacing-xl) 0;
		color: var(--color-secondary);
	}

	.ranking__cabecera,
	.ranking__fila {
		display: grid;
		grid-template-columns: 2rem minmax(0, 1fr) 4.25rem;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.ranking__cabecera {
		padding: 0 var(--spacing-sm) var(--spacing-sm);
		font-family: var(--font-body);
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-secondary);
		border-bottom: 1px solid rgba(255, 255, 255, 0.18);
	}

	.ranking__cabecera span:nth-child(3) {
		display: none;
	}

	.ranking__cabecera span:last-child,
	.ranking__goles {
		text-align: right;
	}

	.ranking__fila {
		padding: var(--spacing-md) var(--spacing-sm);
		font-family: var(--font-body);
		border-bottom: 1px solid rgba(255, 255, 255, 0.09);
	}

	.ranking__pos {
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
		color: var(--color-secondary);
	}

	.ranking__jugador {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
		font-size: 0.95rem;
		color: var(--color-neutral);
	}

	.ranking__jugador small {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--color-secondary);
	}

	.ranking__equipo {
		display: none;
		align-items: center;
		gap: var(--spacing-sm);
		font-size: 0.85rem;
		color: var(--color-secondary);
	}

	.ranking__equipo i {
		width: 3px;
		height: 20px;
		background: var(--club);
		border-radius: 2px;
	}

	.ranking__goles {
		font-family: var(--font-headline);
		font-size: 1.5rem;
		line-height: 1;
		color: var(--color-neutral);
		font-variant-numeric: tabular-nums;
	}

	.ranking__goles--lider {
		color: var(--color-primary);
	}

	.ver-todos {
		width: 100%;
		margin-top: var(--spacing-lg);
		padding: var(--spacing-md);
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-neutral);
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: var(--border-radius-sm);
		cursor: pointer;
	}

	.ver-todos:hover,
	.ver-todos:focus-visible {
		border-color: var(--color-primary);
	}

	#goleadores-lista:not(.is-expanded) .ranking__fila--extra {
		display: none;
	}

	@media (min-width: 640px) {
		.ranking__cabecera,
		.ranking__fila {
			grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 1fr) 4.25rem;
		}

		.ranking__cabecera span:nth-child(3) {
			display: block;
		}

		.ranking__cabecera span:nth-child(3),
		.ranking__equipo {
			text-align: left;
		}

		.ranking__equipo {
			display: flex;
		}

		.ranking__jugador small {
			display: none;
		}

		.ranking__fila {
			padding: var(--spacing-md);
		}
	}

	@media (min-width: 1024px) {
		.estadisticas {
			padding: var(--spacing-2xl) 0;
		}

		.ranking__goles {
			font-size: 1.75rem;
		}
	}
</style>

<script>
	const boton = document.getElementById('goleadores-toggle');
	const lista = document.getElementById('goleadores-lista');

	boton?.addEventListener('click', () => {
		const expandido = lista?.classList.toggle('is-expanded') ?? false;
		boton.setAttribute('aria-expanded', String(expandido));
		boton.textContent = expandido ? 'Ver menos' : 'Ver todos los goleadores';
	});
</script>
