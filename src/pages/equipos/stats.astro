---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import SponsorsBanners from "../../components/SponsorsBanners.astro";
import Footer from "../../components/Footer.astro";
import { createServerSupabase } from "../../lib/supabase";

const supabase = createServerSupabase({
	request: Astro.request,
	cookies: Astro.cookies,
});

const equipoId = Astro.url.searchParams.get("id");

if (!equipoId) {
	return Astro.redirect("/equipos");
}

const { data: equipo, error } = await supabase
	.from("equipos")
	.select("id, nombre, ano_creacion, logo_url, presidente, secretaria, tesorera, color_principal")
	.eq("id", equipoId)
	.single();

if (error || !equipo) {
	return Astro.redirect("/equipos");
}

const { data: jugadores } = await supabase
	.from("jugadores")
	.select("id, nombre, apellido, posicion, numero_camiseta, foto_url")
	.eq("equipo_id", equipoId)
	.order("numero_camiseta", { ascending: true })
	.order("apellido");

const { data: cuerpoTecnico } = await supabase
	.from("cuerpo_tecnico")
	.select("id, nombre, rol")
	.eq("equipo_id", equipoId)
	.order("rol");

interface Jugador {
	id: number;
	nombre: string;
	apellido: string;
	posicion: string | null;
	numero_camiseta: number | null;
	foto_url: string | null;
}

interface Tecnico {
	id: number;
	nombre: string;
	rol: string;
}

const players: Jugador[] = (jugadores ?? []) as Jugador[];
const staff: Tecnico[] = (cuerpoTecnico ?? []) as Tecnico[];

const colorPrincipal = equipo.color_principal ?? "#E61E2A";

function posicionIcono(posicion: string | null): string {
	switch (posicion) {
		case "Arquero": return "🧤";
		case "Defensa": return "🛡️";
		case "Mediocampista": return "⚡";
		case "Delantero": return "⚽";
		default: return "👕";
	}
}

function rolLabel(rol: string): string {
	return rol === "DT" ? "Director Técnico" : "Asistente Técnico";
}

const jugadoresPorPosicion: Record<string, Jugador[]> = {
	Arquero: [],
	Defensa: [],
	Mediocampista: [],
	Delantero: [],
};

for (const p of players) {
	const pos = p.posicion ?? "Delantero";
	if (jugadoresPorPosicion[pos]) {
		jugadoresPorPosicion[pos].push(p);
	}
}
---

<Layout>
	<Header />
	<main class="main-content">
		<section class="team-stats">
			<div class="container">
				<a href="/equipos" class="back-link fade-in-up">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
					Volver a equipos
				</a>

				<div class="team-header fade-in-up">
					<div class="team-header__logo-wrapper" style={`background-color: ${colorPrincipal}`}>
						{equipo.logo_url ? (
							<img src={equipo.logo_url} alt={`Logo de ${equipo.nombre}`} class="team-header__logo" />
						) : (
							<span class="team-header__logo-initial">{equipo.nombre.charAt(0)}</span>
						)}
					</div>
					<div class="team-header__info">
						<h1 class="team-header__name">{equipo.nombre}</h1>
						<div class="team-header__details">
							{equipo.ano_creacion && (
								<span class="team-header__detail">
									<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
										<line x1="16" y1="2" x2="16" y2="6"></line>
										<line x1="8" y1="2" x2="8" y2="6"></line>
									</svg>
									Fundado {equipo.ano_creacion}
								</span>
							)}
							<span class="team-header__detail">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
									<circle cx="9" cy="7" r="4"></circle>
									<path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
									<path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
								</svg>
								{players.length} jugador{players.length !== 1 ? "es" : ""}
							</span>
						</div>
					</div>
				</div>

				{(equipo.presidente || equipo.secretaria || equipo.tesorera) && (
					<div class="section-card fade-in-up">
						<h2 class="section-card__title">Directiva</h2>
						<div class="directiva-grid">
							{equipo.presidente && (
								<div class="directiva-item">
									<span class="directiva-item__label">Presidente</span>
									<span class="directiva-item__value">{equipo.presidente}</span>
								</div>
							)}
							{equipo.secretaria && (
								<div class="directiva-item">
									<span class="directiva-item__label">Secretaria</span>
									<span class="directiva-item__value">{equipo.secretaria}</span>
								</div>
							)}
							{equipo.tesorera && (
								<div class="directiva-item">
									<span class="directiva-item__label">Tesorera</span>
									<span class="directiva-item__value">{equipo.tesorera}</span>
								</div>
							)}
						</div>
					</div>
				)}

				{staff.length > 0 && (
					<div class="section-card fade-in-up">
						<h2 class="section-card__title">Cuerpo Técnico</h2>
						<div class="staff-list">
							{
								staff.map((t) => (
									<div class="staff-item">
										<div class="staff-item__icon" style={`background-color: ${colorPrincipal}20; color: ${colorPrincipal}`}>
											{t.rol === "DT" ? "DT" : "AT"}
										</div>
										<div class="staff-item__info">
											<span class="staff-item__name">{t.nombre}</span>
											<span class="staff-item__rol">{rolLabel(t.rol)}</span>
										</div>
									</div>
								))
							}
						</div>
					</div>
				)}

				<div class="section-card fade-in-up">
					<h2 class="section-card__title">Plantilla</h2>

					{players.length === 0 ? (
						<p class="empty-text">Este equipo no tiene jugadores registrados.</p>
					) : (
						<>
							{(["Arquero", "Defensa", "Mediocampista", "Delantero"] as const).map((pos) => {
								const posPlayers = jugadoresPorPosicion[pos];
								if (posPlayers.length === 0) return null;
								return (
									<div class="pos-group">
										<h3 class="pos-group__title">
											<span class="pos-group__icon">{posicionIcono(pos)}</span>
											{pos}es
											<span class="pos-group__count">{posPlayers.length}</span>
										</h3>
										<div class="pos-group__list">
											{
												posPlayers.map((j) => (
													<div class="player-row">
														{j.numero_camiseta && (
															<span class="player-row__number">{j.numero_camiseta}</span>
														)}
														<div class="player-row__info">
															<span class="player-row__name">{j.nombre} {j.apellido}</span>
														</div>
													</div>
												))
											}
										</div>
									</div>
								);
							})}
						</>
					)}
				</div>
			</div>
		</section>
	</main>
	<SponsorsBanners />
	<Footer />
</Layout>

<style>
	.team-stats {
		padding: var(--spacing-lg) 0;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-xs);
		font-family: var(--font-label);
		font-size: 0.8rem;
		color: var(--color-secondary);
		text-decoration: none;
		margin-bottom: var(--spacing-lg);
		transition: color 0.2s;
	}

	.back-link:hover {
		color: var(--color-neutral);
	}

	.team-header {
		display: flex;
		align-items: center;
		gap: var(--spacing-lg);
		margin-bottom: var(--spacing-xl);
		padding: var(--spacing-lg);
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
	}

	.team-header__logo-wrapper {
		width: 80px;
		height: 80px;
		border-radius: var(--border-radius-md);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.team-header__logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 8px;
	}

	.team-header__logo-initial {
		font-family: var(--font-headline);
		font-size: 2.4rem;
		color: var(--color-neutral);
		text-transform: uppercase;
	}

	.team-header__info {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
		min-width: 0;
	}

	.team-header__name {
		font-family: var(--font-headline);
		font-size: 1.6rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		line-height: 1.2;
	}

	.team-header__details {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-md);
	}

	.team-header__detail {
		display: flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-label);
		font-size: 0.7rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.team-header__detail svg {
		opacity: 0.5;
		flex-shrink: 0;
	}

	.section-card {
		background: linear-gradient(
			145deg,
			var(--color-tertiary-light) 0%,
			var(--color-tertiary) 100%
		);
		border-radius: var(--border-radius-lg);
		border: 1px solid rgba(255, 255, 255, 0.06);
		box-shadow: var(--shadow-sm);
		padding: var(--spacing-lg);
		margin-bottom: var(--spacing-lg);
	}

	.section-card__title {
		font-family: var(--font-headline);
		font-size: 1.1rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-md);
		padding-bottom: var(--spacing-sm);
		border-bottom: 2px solid var(--color-primary);
	}

	.directiva-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-md);
	}

	.directiva-item {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.directiva-item__label {
		font-family: var(--font-label);
		font-size: 0.65rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		opacity: 0.7;
	}

	.directiva-item__value {
		font-family: var(--font-body);
		font-size: 0.95rem;
		color: var(--color-neutral);
	}

	.staff-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.staff-item {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-sm) var(--spacing-md);
		background: rgba(255, 255, 255, 0.03);
		border-radius: var(--border-radius-sm);
	}

	.staff-item__icon {
		width: 40px;
		height: 40px;
		border-radius: var(--border-radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-headline);
		font-size: 0.85rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.staff-item__info {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.staff-item__name {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-neutral);
	}

	.staff-item__rol {
		font-family: var(--font-label);
		font-size: 0.65rem;
		color: var(--color-secondary);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.empty-text {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-secondary);
		font-style: italic;
		text-align: center;
		padding: var(--spacing-lg) 0;
	}

	.pos-group {
		margin-bottom: var(--spacing-lg);
	}

	.pos-group:last-child {
		margin-bottom: 0;
	}

	.pos-group__title {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-headline);
		font-size: 0.9rem;
		text-transform: uppercase;
		color: var(--color-neutral);
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-sm);
	}

	.pos-group__icon {
		font-size: 1rem;
	}

	.pos-group__count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-primary);
		color: var(--color-neutral);
		font-family: var(--font-label);
		font-size: 0.65rem;
		font-weight: 700;
		margin-left: auto;
	}

	.pos-group__list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}

	.player-row {
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		padding: var(--spacing-sm) var(--spacing-md);
		background: rgba(255, 255, 255, 0.02);
		border-radius: var(--border-radius-sm);
		transition: background 0.2s;
	}

	.player-row:hover {
		background: rgba(255, 255, 255, 0.05);
	}

	.player-row__number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: var(--border-radius-sm);
		background: rgba(255, 255, 255, 0.06);
		font-family: var(--font-headline);
		font-size: 0.85rem;
		color: var(--color-secondary);
		flex-shrink: 0;
	}

	.player-row__info {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.player-row__name {
		font-family: var(--font-body);
		font-size: 0.9rem;
		color: var(--color-neutral);
	}

	@media (min-width: 640px) {
		.team-stats {
			padding: var(--spacing-xl) 0;
		}

		.team-header {
			padding: var(--spacing-xl);
		}

		.team-header__logo-wrapper {
			width: 100px;
			height: 100px;
		}

		.team-header__logo-initial {
			font-size: 3rem;
		}

		.team-header__name {
			font-size: 2rem;
		}

		.team-header__detail {
			font-size: 0.75rem;
		}

		.section-card {
			padding: var(--spacing-xl);
		}

		.section-card__title {
			font-size: 1.2rem;
		}

		.directiva-grid {
			grid-template-columns: 1fr 1fr 1fr;
		}

		.pos-group__title {
			font-size: 1rem;
		}

		.player-row__name {
			font-size: 0.95rem;
		}
	}

	@media (min-width: 1024px) {
		.team-stats {
			padding: var(--spacing-2xl) 0;
		}

		.team-header {
			padding: var(--spacing-2xl);
			gap: var(--spacing-xl);
		}

		.team-header__logo-wrapper {
			width: 120px;
			height: 120px;
		}

		.team-header__logo-initial {
			font-size: 3.6rem;
		}

		.team-header__name {
			font-size: 2.4rem;
		}

		.section-card__title {
			font-size: 1.3rem;
		}
	}

	@media (min-width: 1280px) {
		.team-header__name {
			font-size: 2.8rem;
		}

		.team-header__logo-wrapper {
			width: 140px;
			height: 140px;
		}

		.team-header__logo-initial {
			font-size: 4rem;
		}
	}
</style>
